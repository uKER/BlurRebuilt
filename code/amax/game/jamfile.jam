;


if $(PLATFORM) = PS3
{
	DLC_SRC = 
	[ Batch
	./Game/DLC/DLC_Types.cpp
	./Game/DLC/DLC_Controller.cpp
	./Game/DLC/DLC_Controller_PS3.cpp
	: StdAfx.h ]
	;

	ACHIEVEMENT_SRC = 
	[ Batch
	./Game/Achievements/AchievementSystem_PS3.cpp
	./Game/Achievements/AvatarAwardSystem_PS3.cpp
	./Game/Achievements/PictureAwardSystem_PS3.cpp
	: StdAfx.h ]
	;

	GAME_DATA_INSTALLER_SRC = 
	./PS3Installer/PS3InstallData.cpp
	;
	
}

if $(PLATFORM) = PC
{
	DLC_SRC = 
	[ Batch
	./Game/DLC/DLC_Types.cpp
	./Game/DLC/DLC_Controller.cpp
	./Game/DLC/DLC_Controller_PC.cpp
	: StdAfx.h ]
	;

	ACHIEVEMENT_SRC = 
	[ Batch
	./Game/Achievements/AchievementSystem_PC.cpp
	./Game/Achievements/AvatarAwardSystem_PC.cpp
	./Game/Achievements/PictureAwardSystem_PC.cpp
	: StdAfx.h ]
	;
}

EFFECTS_SRC = 
./Game/GameActors/Effects/EffectTestActor.cpp
;

CROWDS_SRC =
./Game/GameActors/Crowds/CrowdGameActor.cpp
;

SPUSRC =
	<SPU>./Game/GameWorld/GameWorldTasks.cpp
;

LinkLibraries carupdatelightcubemap : core_spu ;

AddSPUModule Amax : carupdatelightcubemap : $(SPUSRC) ;

if $(USERNAME) = cwright || $(USERNAME) = sbilton || $(USERNAME) = caspinall || $(USERNAME) = pkerby || $(USERNAME) = gayoung || $(USERNAME) = dgill || $(USERNAME) = pereid || $(USERNAME) = gsmillie
{
	SrcOptim $(VEHICLE_SRC) : Off ;
}

if $(USERNAME) = sbilton
{
	SrcOptim $(DLC_SRC) : Off ;
}

if $(USERNAME) = pkerby || $(USERNAME) = gayoung || $(USERNAME) = mtaylor || $(USERNAME) = jbunner || $(USERNAME) = gsmillie
{
	SrcOptim $(ACHIEVEMENT_SRC) : Off ;
}

if $(USERNAME) = caspinall
{
	SrcOptim $(WEAPONS_SRC) : Off ;
}

if $(USERNAME) = caspinall
{
	SrcOptim $(RACELOGIC_SRC) : Off ;
}

include demonware.jam ;
include air_amax.jam ;
include graphics.jam ;
include RaceLogic.jam ;
include ../Library/Ui/uiluasrc.jam ;

ImportCP include/ui/shaders/vsConstants.h : TOP Code Mercury Library UI ;
ImportCP include/ui/shaders/psConstants.h : TOP Code Mercury Library UI ;

SRC += $(VEHICLE_SRC) $(DRIVER_SRC) $(WEAPONS_SRC) $(EFFECTS_SRC) $(CROWDS_SRC) $(RACELOGIC_SRC) $(GRAPHICS_SRC) $(AIR_AMAX_SRC) $(DLC_SRC) $(ACHIEVEMENT_SRC) ;

SRC += $(GRAPHICS_SHADERS) ;

if $(PLATFORM) = PS3
{
	SRC += $(GAME_DATA_INSTALLER_SRC) ;
}

