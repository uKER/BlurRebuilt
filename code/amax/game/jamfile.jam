SubDir TOP Code Amax Game ;

SupportedTargets WIN32 PS3 ;

CheckPS3SDKVersion "310.001" ;

MERCURY = $(TOP)/Code/Mercury/Library ;

SHADER_HASH_FILE = $(TOP)/Code/Amax/Game/Shaders/shader_hash2.txt ;

Define USE_SOLVER_2 ;

Define CREATE_CROWD_FLAG_RENDERER ;

#EnableCallcap ;

if $(BUILD) != Profile && $(BUILD) != Master
{
	Define LOGFS_ENABLE ;
	Define CFILESYSTEM_CREATE_FUNC_ENABLED ;
}

IncludePath 
Amax$(_PLATFORM)
Amax$(_PLATFORM)/include
$(MERCURY)/ai/air/include
$(MERCURY)/animation/include
$(MERCURY)/audio/include
$(MERCURY)/common/core/include
$(MERCURY)/common/system/include
$(MERCURY)/common/btl/include
$(MERCURY)/common/misc_shared/include
$(MERCURY)/common/xt2/include
$(MERCURY)/gamesys/actor_system/include
$(MERCURY)/gamesys/advertising/include
$(MERCURY)/gamesys/animated_model/include
$(MERCURY)/gamesys/crowd_system/include
$(MERCURY)/gamesys/debugsystems/include
$(MERCURY)/gamesys/framework/include
$(MERCURY)/gamesys/game_context/include
$(MERCURY)/gamesys/game_debug/include
$(MERCURY)/gamesys/game_resource/include
$(MERCURY)/gamesys/GameView/include
$(MERCURY)/gamesys/lod/include
$(MERCURY)/gamesys/helper_screens/include
$(MERCURY)/gamesys/resource_utils/include
$(MERCURY)/gamesys/shared_actors/include
$(MERCURY)/gamesys/SpecialFX/include
$(MERCURY)/gamesys/AuxFlares/include
$(MERCURY)/gamesys/LightTrails/include
$(MERCURY)/gamesys/SplashCamera/include
$(MERCURY)/graphics/camera2/include
$(MERCURY)/graphics/deferred/include
$(MERCURY)/graphics/display/include
$(MERCURY)/graphics/display2/include
$(MERCURY)/graphics/dynamic/include
$(MERCURY)/graphics/effect/include
$(MERCURY)/graphics/fx/include
$(MERCURY)/graphics/movie/include
$(MERCURY)/graphics/portal/include
$(MERCURY)/graphics/render/include
$(MERCURY)/graphics/renderingdata/include
$(MERCURY)/graphics/scenegraph/include
$(MERCURY)/graphics/shader/include
$(MERCURY)/graphics/spu/include
$(MERCURY)/graphics/world_render/include
$(MERCURY)/graphics/Ngl/include
$(MERCURY)/graphics/textureresource/include
$(MERCURY)/graphics/vehicle/include
$(MERCURY)/network/include
$(MERCURY)/physics/gravity/include
$(MERCURY)/physics/racingphysics/include
$(MERCURY)/util/input/include
$(MERCURY)/util/JpegHelper/include
$(MERCURY)/util/lua_shared/include
$(MERCURY)/util/resource/include
$(MERCURY)/util/logicalfs/include
$(MERCURY)/util/security/include
$(MERCURY)/util/actor_studio_msg_shared/include
$(MERCURY)/ui/include
$(MERCURY)/gamesys/blobshadows/include
$(MERCURY)/gamesys/dropshadows/include
$(MERCURY)/gamesys/actor_studio_msg_game/include
$(TOP)/code/vendor/lua/Lua-5.1.4/src
$(TOP)/code/vendor/lua/Lua-Helper/include
$(TOP)/code/vendor/zlib/current_mercury
$(TOP)/code/Amax/Library
$(TOP)/Libs/Vendor/Bink/1.9r
;

if $(INCREMENTAL_LINKING) = 1
{
    ObjectCcFlags ./GameApp.cpp : -DINCREMENTAL_LINKING ;
}

if $(PLATFORM) = PC
{
IncludePath \"$(DXSDK_PATH)/include\" 
$(TOP)/libs/vendor/openal/1.1/include ;
#echo $(DXSDK_PATH)/include ;
LINKLIBS += secur32.lib crypt32.lib ws2_32.lib dbghelp.lib psapi.lib "$(DXSDK_PATH)/Lib/x86/dxerr.lib" "$(DXSDK_PATH)/Lib/x86/d3d9.lib" "$(DXSDK_PATH)/Lib/x86/d3dx9.lib" "$(DXSDK_PATH)/Lib/x86/dinput8.lib" "$(DXSDK_PATH)/Lib/x86/dxguid.lib" "$(DXSDK_PATH)/Lib/x86/xinput.lib" "$(TOP)/libs/vendor/openal/1.1/lib/Win32/OpenAL32.lib" "$(TOP)/libs/vendor/openal/1.1/lib/Win32/EFX-Util.lib" ;
LINKFLAGS += /SUBSYSTEM:WINDOWS /MACHINE:X86 /DEBUG ;
LINKFLAGS += /NODEFAULTLIB:LIBCMTD /NODEFAULTLIB:LIBCMT ;
}


PS3LIBS = 
$(TOP)/libs/vendor/bink/1.9r/binkps3 
$(SCE_PS3_ROOT)/target/ppu/lib/libsysutil_np2_stub 
$(SCE_PS3_ROOT)/target/ppu/lib/libl10n_stub
$(SCE_PS3_ROOT)/target/ppu/lib/libvoice_stub
$(SCE_PS3_ROOT)/target/ppu/lib/libhttp_stub
$(SCE_PS3_ROOT)/target/ppu/lib/libhttp_util_stub
$(SCE_PS3_ROOT)/target/ppu/lib/libssl_stub
$(SCE_PS3_ROOT)/target/ppu/lib/libsysutil_np_trophy_stub
$(SCE_PS3_ROOT)/target/ppu/lib/hash/libsha1 
;

PCLIBS = 
$(TOP)/libs/vendor/bink/1.9r/binkw32
;


# Massive Advertising

if $(PLATFORM) = PC
{
	if $(BUILD) = Master
	{
		PCLIBS += $(TOP)/libs/vendor/massive/3.7.1.106/lib/x86/static/xmassiveadclient ;
	}
	else
	{
		PCLIBS += $(TOP)/libs/vendor/massive/3.7.1.106/lib/x86/static/xmassiveadclientlogging ;
	}
}

SRC =
[ Batch
./Automation/GameAutomationMessageHandler.cpp
./Automation/GamePerfLogging.cpp
./Game/ActorDef/ActorTypes.cpp
./Game/ActorDef/GameActor.cpp
./Game/ActorDef/GameActorList.cpp
./Game/PerfStats/PerfStats.cpp
: StdAfx.h ]

[ Batch
./Game/AmaxCam/AmaxChaseCamera.cpp
./Game/AmaxCam/BoltedCamera.cpp
./Game/AmaxCam/CameraActor.cpp
./Game/AmaxCam/CameraKeyFrame.cpp
./Game/AmaxCam/CameraSwitcher.cpp
./Game/AmaxCam/CameraSystem.cpp
./Game/AmaxCam/CameraSpecialFX.cpp
./Game/AmaxCam/CubeCapture.cpp
./Game/AmaxCam/DirectorActor.cpp
./Game/AmaxCam/FatalCamera.cpp
./Game/AmaxCam/HOGResetCamera.cpp
./Game/AmaxCam/SetPieceCamera.cpp
./Game/AmaxCam/Helper.cpp
./Game/AmaxCam/PassingShake.cpp
./Game/AmaxCam/PhotoCamera2.cpp
./Game/AmaxCam/PhysicsChecks.cpp
./Game/AmaxCam/RayGroup.cpp
./Game/AmaxCam/Sorcery.cpp
./Game/AmaxCam/VehicleFeed.cpp
./Game/AmaxCam/CameraDollyZoomSpecialFX.cpp
./Game/AmaxCam/CameraNoiseSpecialFX.cpp
: StdAfx.h ]

[ Batch
./Game/GameControls/GameControls.cpp
./Game/GameDef/Materials.cpp
./Game/GameDef/PhysicsConstants.cpp
./Game/GameDef/Polyflags.cpp
./Game/GameUtil/ResourceBag.cpp
./Game/GameUtil/ResourceBagListener.cpp
./Game/GameWorld/EnvironmentSettings.cpp
./Game/GameWorld/GameWorld.cpp
./Game/GameWorld/GameWorldOverrideCubemap.cpp
./Game/GameWorld/GameWorldTasks.cpp
./Game/GameWorld/PostProcessLayer.cpp
./Game/GameWorld/View.cpp
./Game/GameWorld/ViewManager.cpp
<view>./Game/GameWorld/View/Main.cpp
./Game/GameWorld/View/Mirror.cpp
./Game/GameWorld/View/Reflection.cpp
./Game/GameWorld/View/CubeMap.cpp
./Game/Messaging/GameMessaging.cpp
./Game/SimpleUi/SimpleUiLayer.cpp
./Game/SystemLayer.cpp
./Game/Game.cpp
: StdAfx.h ]

[ Batch
./PlatformCallbacks/PlatformCallbacks_$(PLATFORM).cpp
./GameSystems.cpp
./Main.cpp
./AppPhotoCapture.cpp
./SchedulerConfig.cpp
./Game/GameUtil/LoadingPerf.cpp
: StdAfx.h ]
./GameApp.cpp
./GameAppResources.cpp
;

if $(BUILD) != Master
{
SRC +=
[ Batch
./Automation/GameDataLogging.cpp
: StdAfx.h ]
;
}

DRIVER_SRC =
[ Batch
Game/GameActors/Drivers/AnimationTree.cpp
Game/GameActors/Drivers/DriverActor.cpp
Game/GameActors/Drivers/DriverAnimationParameters.cpp
Game/GameActors/Drivers/DriverManager.cpp
Game/GameActors/Drivers/XtAnimationTree.cpp
Game/GameActors/Drivers/XtAnimationTreeListener.cpp
