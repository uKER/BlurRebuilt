if $(PLATFORM) = PC
{
	IncludePath \"$(DXSDK_PATH)/include\" $(TOP)/libs/vendor/openal/1.1/include ;
}

SRC = 
./Game/GameActors/AudioActors.cpp
./Game/GameActors/Components/AudioComponents.cpp
./Game/GameActors/Components/AudioMessageHandlers/BaseMessageHandler.cpp
./Game/GameActors/Components/Creation/AudioComponentsCreate.cpp
./Game/GameActors/Components/GameComponents.cpp
./Game/GameActors/Components/Messages/AudioMessages.cpp
./GameAudio/DefaultSubsystem.cpp
./GameAudio/GameAudioLayer.cpp
./GameAudio/MusicSubsystem.cpp
./GameAudio/VehicleSubsystem.cpp
./GameAudio/UISubsystem.cpp
./GameAudio/DialogueSubsystem.cpp
./GameAudio/SystemSubsystem.cpp
./GameAudio/DynamicObjSubsystem.cpp
./GameAudio/WheelSubsystem.cpp
./GameAudio/ListenerSubsystem.cpp
./GameAudio/EntitySuspendResume.cpp
./GameAudio/PickupSubsystem.cpp
./GameAudio/CollisionSubsystem.cpp
;

SRC2 = 
;


SRC = [ Batch $(SRC) : StdAfx.h ] $(SRC2) ;

ImportCP include/ui/shaders/vsConstants.h : TOP Code Mercury Library UI ;
ImportCP include/ui/shaders/psConstants.h : TOP Code Mercury Library UI ;

Library amax_audio : $(SRC) : StdAfx.cpp ;
