			<LocalizedString clsid="{F88D7D87-B2C0-452D-977D-297D70400AFF}" id="3" friendlyName="Developer">
				<Translation locale="de-DE">Bizarre Creations</Translation>
				<Translation locale="en-US">Bizarre Creations</Translation>
				<Translation locale="es-ES">Bizarre Creations</Translation>
				<Translation locale="fr-FR">Bizarre Creations</Translation>
				<Translation locale="it-IT">Bizarre Creations</Translation>
