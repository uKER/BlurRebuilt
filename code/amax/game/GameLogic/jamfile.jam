if $(PLATFORM) = PC
{
	IncludePath \"$(DXSDK_PATH)/include\" $(TOP)/libs/vendor/openal/1.1/include ;
}

if $(BUILD) != Profile && $(BUILD) != Master
{
	if $(BUILD) != Speed
	{
		if $(USERNAME) = sbilton || $(USERNAME) = caspinall || $(USERNAME) = dwood || $(USERNAME) = gayoung || $(USERNAME) = cwright || $(USERNAME) = tstockton || $(USERNAME) = pereid || $(USERNAME) = jbunner || $(USERNAME) = scakebread || $(USERNAME) = gsmillie || $(USERNAME) = wbrown || $(USERNAME) = mtaylor || $(USERNAME) = asimpson || $(USERNAME) = dgill || $(USERNAME) = wbrown
		{
			Optim Off ;
			echo OPTIMISATIONS ARE _OFF_ FOR GameLogic code ;
		}
	}
	
	# We want it off on speed
	if $(USERNAME) = sbilton || $(USERNAME) = pkerby || $(USERNAME) = gsmillie || $(USERNAME) = mtaylor || $(USERNAME) = scakebread || $(USERNAME) = cwright || $(USERNAME) = pereid || $(USERNAME) = asimpson
	{
		Optim Off ;
		echo OPTIMISATIONS ARE _OFF_ FOR GameLogic code ;
	}
}

