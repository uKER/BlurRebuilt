SubDir TOP Code Amax tools scene_converter ;

SupportedTargets WIN32_TOOL WIN64_TOOL ;

MERCURY = $(TOP)/Code/Mercury/Library ;

USE_SOLVER2 = 1 ;

if $(USE_SOLVER2) != 1
{
#echo define solver 1 ;
}
else
{
#echo define solver 2 ;
	Define USE_SOLVER_2 ;
}

# Uncomment to disable the check of sceneconverter file time during the export (debugging)
# Define NOCHECK_SCENECONVERTER_FILE_TIME ;

IncludePath
./source
$(MERCURY)/Common/Core/include
$(MERCURY)/Common/System/include
$(MERCURY)/Common/Btl/include
$(MERCURY)/Util/Tools_shared/include
$(MERCURY)/Util/spatial_hierarchy/include
$(MERCURY)/graphics/texture_export/include
$(MERCURY)/graphics/fx/include
$(MERCURY)/graphics/shader/include
$(MERCURY)/physics/gravity/include
$(MERCURY)/Common/Misc_Shared/include
$(TOP)/Code/Mercury/Library/Graphics/RenderingData/include
$(TOP)/Code/Tools/Aftk/Aftk/include
$(TOP)/code/Tools/Aftkut/AftkUtLib/include
$(TOP)/Code/Tools/Attk/Attk/include
$(TOP)/Code/Vendor/tclap/current
$(TOP)/Code/Amax/Tools/converter_shared/converter_shared/include
;

SRC =
source/Application.cpp
source/data/AftkSceneData.cpp
source/data/ConversionOptions.cpp
source/data/NullData.cpp
source/data/PhysicsData.cpp
source/data/RenderData.cpp
source/data/SceneDescription.cpp
source/data/ToolConfig.cpp
source/data/LightListData.cpp
source/data/LightSamplePointsData.cpp
source/Main.cpp
source/Polyflags.cpp
source/process/BuildPhysicsData.cpp
source/process/BuildRenderData.cpp
source/process/BuildSceneDescription.cpp
source/process/CreateLightSamplePointsFile.cpp
source/process/ExportGameScene.cpp
source/process/LightAftk.cpp
source/process/NullProcess.cpp
source/process/PreprocessAftk.cpp
source/process/ReadLitAftk.cpp
source/process/WritePreprocessedAftk.cpp
source/process/ReadLightSamplePointsFile.cpp
source/process/LightList.cpp
resource.rc
;

LinkLibraries scene_converter : 
	core 
	system 
	misc_shared 
	gravity 
	RenderingData 
	fx
	xefx
	ps3fx
	pcfx
	shader
	texture_export 
	tools_shared 
	aftk 
	aftkutlib 
	attk
	converter_shared 
	spatial_hierarchy
	$(TOP)/libs/vendor/xsiftk/5.11/lib/xsiftk ;
		
if $(PLATFORM) = PC
{
	SUBDIRHDRS += \"$(DXSDK_PATH)/include\" ;
	LINKLIBS += "$(DXSDK_PATH)/Lib/x86/d3d9.lib" "$(DXSDK_PATH)/Lib/x86/d3dx9.lib" "$(DXSDK_PATH)/Lib/x86/dinput8.lib" "$(DXSDK_PATH)/Lib/x86/dxguid.lib" "$(DXSDK_PATH)/Lib/x86/dxerr.lib" ;
}

Application scene_converter : $(SRC) : stdafx.cpp ;
ExportVcproj scene_converter ;

include $(TOP)/code/mercury/library/graphics/shader/fx.jam ;

SubInclude TOP Code Mercury Library Common Core ;
SubInclude TOP Code Mercury Library Common System ;
SubInclude TOP Code Mercury Library Common misc_shared ;
SubInclude TOP Code Mercury Library Common Btl ;
SubInclude TOP Code Mercury Library Physics Gravity ;
SubInclude TOP Code Mercury Library Graphics RenderingData ;
SubInclude TOP Code Mercury Library Graphics Texture_Export ;
SubInclude TOP Code Mercury Library Graphics Fx ;
SubInclude TOP Code Mercury Library Graphics Shader ;
SubInclude TOP Code Mercury Library Util Tools_Shared ;
SubInclude TOP Code Mercury Library Util Spatial_Hierarchy ;
SubInclude TOP Code Tools Aftk Aftk ;
SubInclude TOP Code Tools aftkut aftkutlib ;
SubInclude TOP Code Tools Attk Attk ;
SubInclude TOP Code Amax Tools Converter_shared Converter_shared ;

Depends scene_converter.exe : $(TOP)/bin/tools_wip/win32/scene_converter/ ;
MkDir $(TOP)/bin/tools_wip/win32/scene_converter/ ;

#Copy $(TOP)/bin/tools_wip/win32/scene_converter/scene_converter.exe : scene_converter.exe ;

EmbedManifest $(TOP)/bin/tools_wip/win32/scene_converter/scene_converter.exe : scene_converter.exe ;

Copy $(TOP)/bin/tools_wip/win32/scene_converter/pcfx.exe : pcfx.exe ;
Copy $(TOP)/bin/tools_wip/win32/scene_converter/ps3fx.exe : ps3fx.exe ;
Copy $(TOP)/bin/tools_wip/win32/scene_converter/xefx.exe : xefx.exe ;