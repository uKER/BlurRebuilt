{
	IncludePath \"$(DXSDK_PATH)/include\" $(TOP)/libs/vendor/openal/1.1/include ;
}

if $(USERNAME) = pkerby || $(USERNAME) = dgill || $(USERNAME) = wbrown || $(USERNAME) = pereid || $(USERNAME) = sbilton || $(USERNAME) = psnape || $(USERNAME) = gayoung || $(USERNAME) = mtaylor
{
	if $(BUILD) != Profile && $(BUILD) != Master
	{
		Optim Off ;
		echo OPTIMISATIONS ARE _OFF_ FOR GameUI code ;
	}
}

