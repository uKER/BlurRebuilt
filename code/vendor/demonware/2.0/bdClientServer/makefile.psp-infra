# bdClientServer

SHELL		= /bin/sh

DW_ROOT		?= ..
SCE_TOP		?= /usr/local/sce
PSP_TOP		= $(SCE_TOP)/psp
PSP_LIBDIR	= $(PSP_TOP)/lib

OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/release

INCS		= -I$(PSP_TOP)/include -I$(DW_ROOT) -I$(DW_ROOT)/external/libtomcrypt/src/headers

SOURCE		= bdClient.cpp bdServer.cpp bdCommand/bdCommandFactory.cpp bdCommand/bdCommandGenerator.cpp bdCommand/bdCommandSettings.cpp bdCommand/bdCommandWindow.cpp bdCommand/bdUserCommand.cpp bdPlayer/bdClientPlayerListener.cpp bdPlayer/bdPlayer.cpp bdPlayer/bdPlayerFactory.cpp bdPlayer/bdServerPlayerData.cpp bdPlayer/bdServerPlayerListener.cpp bdPlayer/bdInterest/bdFullInterest.cpp bdPlayer/bdInterest/bdInterestInterface.cpp bdReplica/bdClientReplicaData.cpp bdReplica/bdClientReplicaListener.cpp bdReplica/bdClientReplicaManager.cpp bdReplica/bdInterpolationData.cpp bdReplica/bdInterpolationInterface.cpp bdReplica/bdReplica.cpp bdReplica/bdReplicaFactory.cpp bdReplica/bdReplicaTable.cpp bdReplica/bdServerReplicaData.cpp bdReplica/bdServerReplicaManager.cpp bdReplica/bdIdManager/bdIdManager.cpp bdReplica/bdUpdate/bdRollbackWindow.cpp bdReplica/bdUpdate/bdUpdateSettings.cpp bdReplica/bdUpdate/bdUpdateWindow.cpp 
OBJS		= $(SOURCE:.cpp=-psp.o)

AS		= psp-g++
CC		= psp-g++
LD		= psp-g++
AR		= psp-ar
RANLIB		= psp-ranlib
RM		= /bin/rm -f

CPPFLAGS	= -Wall -fno-exceptions -fno-common -fmessage-length=1000 -fdiagnostics-show-location=once -pipe $(INCS) -DBD_PLATFORM_PSP_INFRA

TARGET		= ../lib/psp-infra/release/libbdclientserver.a

ifdef DEBUG
CPPFLAGS    += -g
OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/debug
TARGET		= ../lib/psp-infra/debug/libbdclientserver.a
endif

OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

all: depend $(TARGET)

clean:
	$(RM) ${OBJS_ABSOLUTE} $(TARGET)

$(TARGET): ${OBJS_ABSOLUTE}
	$(AR) rcs $(TARGET) $(OBJS_ABSOLUTE)

$(OBJ_DIR)/%-psp-psp.o: %-psp.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-psp.cpp -o $(OBJ_DIR)/$*-psp-psp.o

$(OBJ_DIR)/%-psp.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*.cpp -o $(OBJ_DIR)/$*-psp.o

$(OBJ_DIR)/%-ps2-psp.o: %-ps2.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-ps2.cpp -o $(OBJ_DIR)/$*-ps2-psp.o

depend:
	$(RM) .depend
	makedepend -f- -- $(CPPFLAGS) -- $(SOURCE) 2>> /dev/null > .depend

-include .depend
