# bdPeer

SHELL		= /bin/sh

DW_ROOT		?= ..
SCE_TOP		?= /usr/local/sce
PSP_TOP		= $(SCE_TOP)/psp
PSP_LIBDIR	= $(PSP_TOP)/lib

OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/release

INCS		= -I$(PSP_TOP)/include -I$(DW_ROOT) -I$(DW_ROOT)/external/libtomcrypt/src/headers

SOURCE		= bdGame.cpp bdGameLog.cpp bdPeer.cpp bdRound.cpp bdRoundInfo.cpp bdCommand/bdCommand.cpp bdCommand/bdCommandFactory.cpp bdDelivery/bdDeliveryInitializer.cpp bdDelivery/bdDeliveryInterceptor.cpp bdDelivery/bdDeliveryLogger.cpp bdDelivery/bdDeliveryManager.cpp bdDelivery/bdDeliveryManagerInfo.cpp bdDelivery/bdDeliveryManagerListener.cpp bdDelivery/bdDeliveryMessage.cpp bdPlayer/bdPlayer.cpp bdPlayer/bdPlayerFactory.cpp bdPlayer/bdPlayerManager.cpp bdPlayer/bdPlayerManagerListener.cpp bdSession/bdSession.cpp bdSession/bdSessionData.cpp bdSession/bdSessionDataFactory.cpp bdSession/bdSessionHandler.cpp bdSession/bdSessionInfo.cpp bdSession/bdSessionInterceptor.cpp bdSession/bdSessionListener.cpp 
OBJS		= $(SOURCE:.cpp=-psp.o)

AS		= psp-g++
CC		= psp-g++
LD		= psp-g++
AR		= psp-ar
RANLIB		= psp-ranlib
RM		= /bin/rm -f

CPPFLAGS	= -Wall -fno-exceptions -fno-common -fmessage-length=1000 -fdiagnostics-show-location=once -pipe $(INCS) -DBD_PLATFORM_PSP_INFRA

TARGET		= ../lib/psp-infra/release/libbdpeer.a

ifdef DEBUG
CPPFLAGS    += -g
OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/debug
TARGET		= ../lib/psp-infra/debug/libbdpeer.a
endif

OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

all: depend $(TARGET)

clean:
	$(RM) ${OBJS_ABSOLUTE} $(TARGET)

$(TARGET): ${OBJS_ABSOLUTE}
	$(AR) rcs $(TARGET) $(OBJS_ABSOLUTE)

$(OBJ_DIR)/%-psp-psp.o: %-psp.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-psp.cpp -o $(OBJ_DIR)/$*-psp-psp.o

$(OBJ_DIR)/%-psp.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*.cpp -o $(OBJ_DIR)/$*-psp.o

$(OBJ_DIR)/%-ps2-psp.o: %-ps2.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-ps2.cpp -o $(OBJ_DIR)/$*-ps2-psp.o

depend:
	$(RM) .depend
	makedepend -f- -- $(CPPFLAGS) -- $(SOURCE) 2>> /dev/null > .depend

-include .depend
