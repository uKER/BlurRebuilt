# bdSocket

SHELL		= /bin/sh

DW_ROOT		?= ..
SCE_TOP		?= /usr/local/sce
PSP_TOP		= $(SCE_TOP)/psp
PSP_LIBDIR	= $(PSP_TOP)/lib

OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/release

INCS		= -I$(PSP_TOP)/include -I$(DW_ROOT) -I$(DW_ROOT)/external/libtomcrypt/src/headers

SOURCE		= bdAddressMap.cpp bdAddrHandle.cpp bdAddrHandleRefWrapper.cpp bdPacketInterceptor.cpp bdSecurityKeyMap.cpp bdServiceBandwidthArbitrator.cpp bdSocketRouter.cpp bdSocketRouterConfig.cpp bdDTLS/bdDTLSAssociation.cpp bdDTLS/bdPacket/bdDTLSCookieAck.cpp bdDTLS/bdPacket/bdDTLSCookieEcho.cpp bdDTLS/bdPacket/bdDTLSData.cpp bdDTLS/bdPacket/bdDTLSError.cpp bdDTLS/bdPacket/bdDTLSHeader.cpp bdDTLS/bdPacket/bdDTLSInit.cpp bdDTLS/bdPacket/bdDTLSInitAck.cpp bdNAT/bdIPDiscoveryClient.cpp bdNAT/bdIPDiscoveryConfig.cpp bdNAT/bdIPDiscoveryServer.cpp bdNAT/bdNATTravClient.cpp bdNAT/bdNATTravClientData.cpp bdNAT/bdNATTravListener.cpp bdNAT/bdNATTravServer.cpp bdNAT/bdNATTypeDiscoveryClient.cpp bdNAT/bdNATTypeDiscoveryConfig.cpp bdNAT/bdNATTypeDiscoveryServer.cpp bdNAT/bdPacket/bdIPDiscoveryPacket.cpp bdNAT/bdPacket/bdIPDiscoveryPacketReply.cpp bdNAT/bdPacket/bdNATTraversalPacket.cpp bdNAT/bdPacket/bdNATTypeDiscoveryPacket.cpp bdNAT/bdPacket/bdNATTypeDiscoveryPacketReply.cpp bdQoS/bdQoSProbe.cpp bdQoS/bdQoSProbeListener.cpp bdQoS/bdPacket/bdQoSReplyPacket.cpp bdQoS/bdPacket/bdQoSRequestPacket.cpp bdRelay/bdRelayRouteManager.cpp bdRelay/bdRelaySocketRouter.cpp bdRelay/bdPacket/bdRelayerInfo.cpp bdRelay/bdPacket/bdRelayFinal.cpp bdRelay/bdPacket/bdRelayForward.cpp bdRelay/bdPacket/bdRelayHeader.cpp bdRelay/bdPacket/bdRelayRouteAdd.cpp bdRelay/bdPacket/bdRelayRouteRemove.cpp 
OBJS		= $(SOURCE:.cpp=-psp.o)

AS		= psp-g++
CC		= psp-g++
LD		= psp-g++
AR		= psp-ar
RANLIB		= psp-ranlib
RM		= /bin/rm -f

CPPFLAGS	= -Wall -fno-exceptions -fno-common -fmessage-length=1000 -fdiagnostics-show-location=once -pipe $(INCS) -DBD_PLATFORM_PSP_INFRA

TARGET		= ../lib/psp-infra/release/libbdsocket.a

ifdef DEBUG
CPPFLAGS    += -g
OBJ_DIR		= $(DW_ROOT)/obj/psp-infra/debug
TARGET		= ../lib/psp-infra/debug/libbdsocket.a
endif

OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

all: depend $(TARGET)

clean:
	$(RM) ${OBJS_ABSOLUTE} $(TARGET)

$(TARGET): ${OBJS_ABSOLUTE}
	$(AR) rcs $(TARGET) $(OBJS_ABSOLUTE)

$(OBJ_DIR)/%-psp-psp.o: %-psp.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-psp.cpp -o $(OBJ_DIR)/$*-psp-psp.o

$(OBJ_DIR)/%-psp.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*.cpp -o $(OBJ_DIR)/$*-psp.o

$(OBJ_DIR)/%-ps2-psp.o: %-ps2.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-ps2.cpp -o $(OBJ_DIR)/$*-ps2-psp.o

depend:
	$(RM) .depend
	makedepend -f- -- $(CPPFLAGS) -- $(SOURCE) 2>> /dev/null > .depend

-include .depend
