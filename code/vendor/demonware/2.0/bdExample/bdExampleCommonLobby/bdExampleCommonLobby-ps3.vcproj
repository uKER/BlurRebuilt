<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="bdExampleCommonLobby">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="PS3 Debug|Win32"
			OutputDirectory="../..\lib\ps3-sn\debug"
			IntermediateDirectory="../..\obj\ps3-sn\debug\bdExampleCommonLobby"
			ConfigurationType="4"
			DeleteExtensionsOnClean="*.obj;*.d;*.map;*.lst;*.pch;$(TargetPath)">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="-g -O0 -Wall"
				AdditionalIncludeDirectories="../..;;../..\external\libtomcrypt\src\headers;&quot;$(SN_PS3_PATH)\include&quot;;&quot;$(SCE_PS3_ROOT)\target-ceb\ppu\include&quot;;&quot;$(SCE_PS3_ROOT)\target-ceb\ppu\include\network&quot;"
				PreprocessorDefinitions="SN_TARGET_PS3;_DEBUG;__GCC__;BD_PLATFORM_PS3"
				ProgramDataBaseFileName=""
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLibrarianTool"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>

		<Configuration
			Name="PS3 Release|Win32"
			OutputDirectory="../..\lib\ps3-sn\release"
			IntermediateDirectory="../..\obj\ps3-sn\release\bdExampleCommonLobby"
			ConfigurationType="4"
			DeleteExtensionsOnClean="*.obj;*.d;*.map;*.lst;*.pch;$(TargetPath)">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="-O2 -Wall"
				AdditionalIncludeDirectories="../..;;../..\external\libtomcrypt\src\headers;&quot;$(SN_PS3_PATH)\include&quot;;&quot;$(SCE_PS3_ROOT)\target-ceb\ppu\include&quot;;&quot;$(SCE_PS3_ROOT)\target-ceb\ppu\include\network&quot;"
				PreprocessorDefinitions="SN_TARGET_PS3;NDEBUG;__GCC__;BD_PLATFORM_PS3"
				ProgramDataBaseFileName=""
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLibrarianTool"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<Files>
<File RelativePath="bdExampleCommonLobby.cpp"></File>
<File RelativePath="bdExampleCommonLobby.h"></File>
<File RelativePath="PrintableList.h"></File>
<File RelativePath="PrintableList.inl"></File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
