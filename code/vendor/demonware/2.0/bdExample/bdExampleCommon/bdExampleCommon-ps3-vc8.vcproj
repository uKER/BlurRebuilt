				Name="VCCLCompilerTool"
				AdditionalOptions="-O2 -Wall -fno-exceptions"
				AdditionalIncludeDirectories="&quot;$(SN_PS3_PATH)\ppu\include\sn&quot;;&quot;$(SCE_PS3_ROOT)\target\ppu\include&quot;;&quot;$(SCE_PS3_ROOT)\target\common\include&quot;;&quot;../..\external\libtomcrypt\src\headers&quot;;&quot;../..&quot;"
				PreprocessorDefinitions="SN_TARGET_PS3;NDEBUG;__GCC__,BD_PLATFORM_PS3"
				ProgramDataBaseFileName="$(IntDir)\"
				WarnAsError="true"
				DebugInformationFormat="0"
				CompileAs="0"
			/>
