		<targets>
			<target>
				<name>Debug</name>
				<settings>
					<setting entry="intermediateOutput" uuid-alias="Dictionary3">
						<simple>${Workspace}/obj/wii-radix/${TargetName}/${ProjectName}/</simple>
					</setting>
					<setting entry="finalOutputDir" uuid-alias="Dictionary3">
						<simple>../../lib/wii-radix/${TargetName}</simple>
					</setting>
					<setting entry="finalOutputName" uuid-alias="Dictionary3">
						<simple>libtomcrypt.a</simple>
					</setting>
				</settings>
			</target>
			<target>
				<name>Release</name>
				<settings>
					<setting entry="intermediateOutput" uuid-alias="Dictionary3">
						<simple>${Workspace}/obj/wii-radix/${TargetName}/${ProjectName}/</simple>
					</setting>
					<setting entry="finalOutputDir" uuid-alias="Dictionary3">
						<simple>${Workspace}/lib/wii-radix/${TargetName}/</simple>
					</setting>
					<setting entry="finalOutputName" uuid-alias="Dictionary3">
						<simple>libtomcrypt.a</simple>
					</setting>
				</settings>
			</target>
		</targets>
		<extensions/>
		<cached-files/>
	</project>
</project-file>
