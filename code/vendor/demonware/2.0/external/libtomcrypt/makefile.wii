# MAKEFILE for linux GCC
#
# Tom St Denis
# Modified by Clay Culver

# The version
VERSION=1.10

CODEWARRIOR_INSTALL_ROOT = "C:/Program Files/Metrowerks/CW_RVL/"
TOOLS_DIR = $(CODEWARRIOR_INSTALL_ROOT)"PowerPC_EABI_Tools/Command_Line_Tools/"
WII_MSL_COMMON_INCLUDES = $(CODEWARRIOR_INSTALL_ROOT)"PowerPC_EABI_Support/MSL/MSL_C/MSL_Common/Include"
WII_PPC_EABI_INCLUDES = $(CODEWARRIOR_INSTALL_ROOT)"PowerPC_EABI_Support/MSL/MSL_C/PPC_EABI/Include"

WII_REVOLUTION_INCLUDES = "C:/RVL_SDK/include/"
WII_REVO_EX_INCLUDES = "C:/RevoEX/include/"

INCS        =  -I$(WII_MSL_COMMON_INCLUDES) -I$(WII_PPC_EABI_INCLUDES) -I$(WII_REVOLUTION_INCLUDES) -I$(WII_REVO_EX_INCLUDES)

COMPILER_APP = mwcceppc.exe
LINKER_APP   = mwldeppc.exe

CC = $(TOOLS_DIR)$(COMPILER_APP)
LD = $(TOOLS_DIR)$(LINKER_APP)

COMPILER_FLAGS = -nodefaults -nolink -library -nosyspath -enum int -Cpp_exceptions off -fp hard  -DGEKKO -D_MSL_CLOCK_T_AVAILABLE -DRVL_OS

C_FLAGS += -c -gccincludes -I./src/headers/ -I../libtommath/ $(INCS) -DLTC_SOURCE  
C_FLAGS += $(COMPILER_FLAGS)

LIBNAME = libtomcrypt.a

LINKER_FLAGS   = -nodefaults  -library -fp hard -o $(LIBNAME)

all: .depend .link 

# excluded objects, have special rules
#src/ciphers/aes/aes_enc.o

