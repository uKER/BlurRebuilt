SOURCE        = $(OBJECTS:.o=.c)
OBJECTS_COMPLETE = $(OBJECTS) 
OBJECTS_COMPLETE +=  src/ciphers/aes/aes_enc.o

.depend:
	$(CC) $(C_FLAGS) $(INCS) $(SOURCE)
	$(CC) $(C_FLAGS) -DENCRYPT_ONLY -c src/ciphers/aes/aes.c -o src/ciphers/aes/aes_enc.o

.link:
	$(LD) $(LINKER_FLAGS) $(OBJECTS_COMPLETE)
