				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
<Includes>
	<Include Dir="../"/>
	<Include Dir=".."/>
	<Include Dir="../external/libtomcrypt/src/headers/"/>
</Includes>
<Libs PreObjects="0">
	<lib File="-Wl,--start-group"/>
	<Lib File="..lib/unix/release/libtomcrypt.a"/>
