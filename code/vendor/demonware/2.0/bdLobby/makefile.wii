# bdLobby

DW_ROOT	    ?= ..
WII_MSL_COMMON_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/MSL_Common/Include/"
WII_PPC_EABI_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/PPC_EABI/Include"
WII_REVOLUTION_INCLUDES = "C:/RVL_SDK/include/"
WII_REVO_EX_INCLUDES = "C:/RevoEX/include/"
LIB_TOM_CRYPT_INCLUDES = $(DW_ROOT)"/external/libtomcrypt/src/headers"

INCS        =  -I$(DW_ROOT) -I$(WII_MSL_COMMON_INCLUDES) -I$(WII_PPC_EABI_INCLUDES) -I$(WII_REVOLUTION_INCLUDES) -I$(WII_REVO_EX_INCLUDES) -I$(LIB_TOM_CRYPT_INCLUDES)

COMPILER_FLAGS = -nodefaults -nolink -library -nosyspath -enum int -Cpp_exceptions off -fp hard  -DGEKKO -D_MSL_CLOCK_T_AVAILABLE -DRVL_OS
LINKER_FLAGS   = -nodefaults  -library -fp hard 


TARGET      = ../lib/wii/release/libbdlobby.a

PLAT        = wii
OPTIMIZE    = release

#ifdef DEBUG
COMPILER_FLAGS    += -g
OPTIMIZE    = debug
TARGET      = ../lib/wii/debug/libbdlobby.a
#endif

OBJ_DIR     = $(DW_ROOT)/obj/$(PLAT)/$(OPTIMIZE)/bdLobby
OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

SOURCE	    = bdAuthService-wii.cpp bdAuthService.cpp bdAuthTicket.cpp bdLobbyConnection.cpp bdLobbyConnectionListener.cpp bdLobbyEventHandler.cpp bdLobbyService.cpp bdContentStreaming/bdContentStreaming.cpp bdContentStreaming/bdContentStreamingStatsInfo.cpp bdContentStreaming/bdFileID.cpp bdContentStreaming/bdFileMetaData.cpp bdContentStreaming/bdQuotaUsage.cpp bdContentStreaming/bdURL.cpp bdContentUnlock/bdContentUnlock.cpp bdContentUnlock/bdUnlockContentInfo.cpp bdCounter/bdCounter.cpp bdCounter/bdCounterValue.cpp bdFacebook/bdFacebook.cpp bdFriends/bdFriendInfo.cpp bdFriends/bdFriendProposal.cpp bdFriends/bdFriends.cpp bdFriends/bdGroupInfo.cpp bdGroup/bdGroup.cpp bdGroup/bdGroupCount.cpp bdGroup/bdGroupID.cpp bdKeyArchive/bdKeyArchive.cpp bdKeyArchive/bdKeyValuePair.cpp bdLinkCode/bdLink.cpp bdLinkCode/bdLinkCode.cpp bdLobbyCommon/bdAuthCommon.cpp bdLobbyCommon/bdTaskResult.cpp bdLSGServices/bdBandwidthTest.cpp bdLSGServices/bdBandwidthTestResults.cpp bdMatchMaking/bdMatchMaking.cpp bdMatchMaking/bdMatchMakingInfo.cpp bdMatchMaking/bdPerformanceValue.cpp bdMatchMaking/bdSessionID.cpp bdMatchMaking/bdSessionInvite.cpp bdMatchMaking/bdSessionParams.cpp bdMessaging/bdBlockedUser.cpp bdMessaging/bdChannelInfo.cpp bdMessaging/bdChannelMember.cpp bdMessaging/bdMailBody.cpp bdMessaging/bdMailHeader.cpp bdMessaging/bdMessaging.cpp bdMessaging/bdNotification.cpp bdProfiles/bdProfileInfo.cpp bdProfiles/bdProfiles.cpp bdRemoteTaskManager/bdRemoteTask.cpp bdRemoteTaskManager/bdRemoteTaskManager.cpp bdStats/bdArbitratedStatsInfo.cpp bdStats/bdSessionNonce.cpp bdStats/bdStats.cpp bdStats/bdStatsInfo.cpp bdStorage/bdFileData.cpp bdStorage/bdFileInfo.cpp bdStorage/bdGetFilesResult.cpp bdStorage/bdStorage.cpp bdTags/bdTag.cpp bdTags/bdTagQueryParams.cpp bdTags/bdTags.cpp bdTags/bdTagsArray.cpp bdTeams/bdTeamInfo.cpp bdTeams/bdTeamMember.cpp bdTeams/bdTeamMemberProfile.cpp bdTeams/bdTeamProfile.cpp bdTeams/bdTeamProposal.cpp bdTeams/bdTeams.cpp bdTitleUtilities/bdTitleStats.cpp bdTitleUtilities/bdTitleUtilities.cpp bdTitleUtilities/bdVerifyString.cpp bdTwitter/bdTwitter.cpp bdVoteRank/bdRatingInfo.cpp bdVoteRank/bdVoteRank.cpp bdVoteRank/bdVoteRankStatsInfo.cpp 

OBJS        = $(SOURCE:.cpp=-wii.o)

TOOLS_DIR = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Tools/Command_Line_Tools/"
COMPILER_APP = mwcceppc.exe
LINKER_APP   = mwldeppc.exe
RM           = /bin/rm -f

all: .depend $(TARGET) .link $(TARGET)

clean:
	$(RM) $(TARGET) $(OBJS_ABSOLUTE)


$(TARGET): $(OBJS_ABSOLUTE)
	ar rcs $(TARGET) $(OBJS_ABSOLUTE)
	
$(OBJ_DIR)/%-wii-wii.o: %-wii.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*-wii.cpp -o $(OBJ_DIR)/$*-wii-wii.o

$(OBJ_DIR)/%-wii.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*.cpp -o $(OBJ_DIR)/$*-wii.o

.depend:
	$(TOOLS_DIR)$(COMPILER_APP) $(COMPILER_FLAGS) $(INCS) $(SOURCE)

.link:
	$(TOOLS_DIR)$(LINKER_APP) $(LINKER_FLAGS) $(OBJS_ABSOLUTE)
