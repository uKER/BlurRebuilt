# bdLobby

SHELL       = /bin/sh

DW_ROOT	    ?= ..
DWPGS_SPECIFIED_PATHS = 
INCS        =  -I$(DW_ROOT)  -I$(DW_ROOT)/external/libtomcrypt/src/headers -I$(DW_ROOT)/external/expat -I$(DW_ROOT)/external/curl-7.19.2/include $(DWPGS_SPECIFIED_PATHS) 


CPPFLAGS    = -Wall -Werror -fno-exceptions -fno-common -fmessage-length=1000 -fdiagnostics-show-location=once -pipe $(INCS)
TARGET      = ../lib/unix/release/libbdlobby.a

PLAT        = unix
OPTIMIZE    = release

ifdef DEBUG
CPPFLAGS    += -g
OPTIMIZE    = debug
TARGET      = ../lib/unix/debug/libbdlobby.a
endif

OBJ_DIR     = $(DW_ROOT)/obj/$(PLAT)/$(OPTIMIZE)/bdLobby
OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

SOURCE	    = bdAuthService.cpp bdAuthTicket.cpp bdLobbyConnection.cpp bdLobbyConnectionListener.cpp bdLobbyEventHandler.cpp bdLobbyService.cpp bdPS3AuthInfo.cpp bdContentStreaming/bdContentStreaming.cpp bdContentStreaming/bdContentStreamingStatsInfo.cpp bdContentStreaming/bdFileID.cpp bdContentStreaming/bdFileMetaData.cpp bdContentStreaming/bdQuotaUsage.cpp bdContentStreaming/bdURL.cpp bdContentUnlock/bdContentUnlock.cpp bdContentUnlock/bdUnlockContentInfo.cpp bdCounter/bdCounter.cpp bdCounter/bdCounterValue.cpp bdFacebook/bdFacebook.cpp bdFriends/bdFriendInfo.cpp bdFriends/bdFriendProposal.cpp bdFriends/bdFriends.cpp bdFriends/bdGroupInfo.cpp bdGroup/bdGroup.cpp bdGroup/bdGroupCount.cpp bdGroup/bdGroupID.cpp bdHTTPWrapper/bdHTTPWrapper.cpp bdKeyArchive/bdKeyArchive.cpp bdKeyArchive/bdKeyValuePair.cpp bdLinkCode/bdLink.cpp bdLinkCode/bdLinkCode.cpp bdLobbyCommon/bdAuthCommon.cpp bdLobbyCommon/bdTaskResult.cpp bdLSGServices/bdBandwidthTest.cpp bdLSGServices/bdBandwidthTestResults.cpp bdMatchMaking/bdMatchMaking.cpp bdMatchMaking/bdMatchMakingInfo.cpp bdMatchMaking/bdPerformanceValue.cpp bdMatchMaking/bdSessionID.cpp bdMatchMaking/bdSessionInvite.cpp bdMatchMaking/bdSessionParams.cpp bdMessaging/bdBlockedUser.cpp bdMessaging/bdChannelInfo.cpp bdMessaging/bdChannelMember.cpp bdMessaging/bdMailBody.cpp bdMessaging/bdMailHeader.cpp bdMessaging/bdMessaging.cpp bdMessaging/bdNotification.cpp bdProfiles/bdProfileInfo.cpp bdProfiles/bdProfiles.cpp bdRemoteTaskManager/bdRemoteTask.cpp bdRemoteTaskManager/bdRemoteTaskManager.cpp bdStats/bdArbitratedStatsInfo.cpp bdStats/bdSessionNonce.cpp bdStats/bdStats.cpp bdStats/bdStatsInfo.cpp bdStorage/bdFileData.cpp bdStorage/bdFileInfo.cpp bdStorage/bdGetFilesResult.cpp bdStorage/bdStorage.cpp bdTags/bdTag.cpp bdTags/bdTagQueryParams.cpp bdTags/bdTags.cpp bdTags/bdTagsArray.cpp bdTeams/bdTeamInfo.cpp bdTeams/bdTeamMember.cpp bdTeams/bdTeamMemberProfile.cpp bdTeams/bdTeamProfile.cpp bdTeams/bdTeamProposal.cpp bdTeams/bdTeams.cpp bdTitleUtilities/bdTitleStats.cpp bdTitleUtilities/bdTitleUtilities.cpp bdTitleUtilities/bdVerifyString.cpp bdTwitter/bdTwitter.cpp bdVoteRank/bdRatingInfo.cpp bdVoteRank/bdVoteRank.cpp bdVoteRank/bdVoteRankStatsInfo.cpp 
OBJS        = $(SOURCE:.cpp=-unix.o)

AS          = g++
CC          = g++
LD          = g++
RM          = /bin/rm -f



all: .depend $(TARGET)

clean:
	$(RM) $(TARGET) $(OBJS_ABSOLUTE)

$(TARGET): $(OBJS_ABSOLUTE)
	ar rcs $(TARGET) $(OBJS_ABSOLUTE)

$(OBJ_DIR)/%-unix-unix.o: %-unix.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-unix.cpp -o $(OBJ_DIR)/$*-unix-unix.o

$(OBJ_DIR)/%-unix.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*.cpp -o $(OBJ_DIR)/$*-unix.o

.depend:
	makedepend -f- -- $(CPPFLAGS) -- $(SOURCE) 2>> /dev/null > .depend

-include .depend
