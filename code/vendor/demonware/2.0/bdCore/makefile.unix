# bdCore

SHELL       = /bin/sh

DW_ROOT	    ?= ..
DWPGS_SPECIFIED_PATHS = 
INCS        =  -I$(DW_ROOT)  -I$(DW_ROOT)/external/libtomcrypt/src/headers -I$(DW_ROOT)/external/expat -I$(DW_ROOT)/external/curl-7.19.2/include $(DWPGS_SPECIFIED_PATHS) 


CPPFLAGS    = -Wall -Werror -fno-exceptions -fno-common -fmessage-length=1000 -fdiagnostics-show-location=once -pipe $(INCS)
TARGET      = ../lib/unix/release/libbdcore.a

PLAT        = unix
OPTIMIZE    = release

ifdef DEBUG
CPPFLAGS    += -g
OPTIMIZE    = debug
TARGET      = ../lib/unix/debug/libbdcore.a
endif

OBJ_DIR     = $(DW_ROOT)/obj/$(PLAT)/$(OPTIMIZE)/bdCore
OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

SOURCE	    = bdCore.cpp bdContainers/bdBitBuffer.cpp bdContainers/bdByteBuffer.cpp bdContainers/bdHashMap.cpp bdContainers/bdSequenceNumber.cpp bdContainers/bdSequenceNumberStore.cpp bdContainers/bdSingleton.cpp bdCrypto/bdCryptoUtils.cpp bdCrypto/bdCypher.cpp bdCrypto/bdCypher3Des.cpp bdCrypto/bdECCKey.cpp bdCrypto/bdHash.cpp bdCrypto/bdHashTiger192.cpp bdCrypto/bdHMac.cpp bdCrypto/bdHMacSHA1.cpp bdCrypto/bdRSAKey.cpp bdMemory/bdAlignedOffsetMemory.cpp bdMemory/bdMallocMemory.cpp bdMemory/bdMemory.cpp bdReference/bdReferencable.cpp bdSocket/bdAddr.cpp bdSocket/bdCommonAddr.cpp bdSocket/bdCommonAddrInfo.cpp bdSocket/bdEndpoint.cpp bdSocket/bdInetAddr.cpp bdSocket/bdMACAddr.cpp bdSocket/bdSecurityID.cpp bdSocket/bdSecurityInfo.cpp bdSocket/bdSecurityKey.cpp bdSocket/bdSocket.cpp bdSocket/bdStreamSocket.cpp bdSocket/bdTestSocket.cpp bdString/bdString.cpp bdThread/bdMutex.cpp bdThread/bdRunnable.cpp bdThread/bdSemaphore.cpp bdThread/bdSignal.cpp bdThread/bdThread.cpp bdTiming/bdStopwatch.cpp bdUtilities/bdBase64.cpp bdUtilities/bdBitOperations.cpp bdUtilities/bdBytePacker.cpp bdUtilities/bdRandom.cpp bdUtilities/bdStringEscape.cpp bdUtilities/bdTrulyRandom.cpp 
OBJS        = $(SOURCE:.cpp=-unix.o)

AS          = g++
CC          = g++
LD          = g++
RM          = /bin/rm -f



all: .depend $(TARGET)

clean:
	$(RM) $(TARGET) $(OBJS_ABSOLUTE)

$(TARGET): $(OBJS_ABSOLUTE)
	ar rcs $(TARGET) $(OBJS_ABSOLUTE)

$(OBJ_DIR)/%-unix-unix.o: %-unix.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*-unix.cpp -o $(OBJ_DIR)/$*-unix-unix.o

$(OBJ_DIR)/%-unix.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(CC) -c $(CPPFLAGS) $*.cpp -o $(OBJ_DIR)/$*-unix.o

.depend:
	makedepend -f- -- $(CPPFLAGS) -- $(SOURCE) 2>> /dev/null > .depend

-include .depend
