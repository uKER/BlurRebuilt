# bdCore

DW_ROOT	    ?= ..
WII_MSL_COMMON_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/MSL_Common/Include/"
WII_PPC_EABI_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/PPC_EABI/Include"
WII_REVOLUTION_INCLUDES = "C:/RVL_SDK/include/"
WII_REVO_EX_INCLUDES = "C:/RevoEX/include/"
LIB_TOM_CRYPT_INCLUDES = $(DW_ROOT)"/external/libtomcrypt/src/headers"

INCS        =  -I$(DW_ROOT) -I$(WII_MSL_COMMON_INCLUDES) -I$(WII_PPC_EABI_INCLUDES) -I$(WII_REVOLUTION_INCLUDES) -I$(WII_REVO_EX_INCLUDES) -I$(LIB_TOM_CRYPT_INCLUDES)

COMPILER_FLAGS = -nodefaults -nolink -library -nosyspath -enum int -Cpp_exceptions off -fp hard  -DGEKKO -D_MSL_CLOCK_T_AVAILABLE -DRVL_OS
LINKER_FLAGS   = -nodefaults  -library -fp hard 


TARGET      = ../lib/wii/release/libbdcore.a

PLAT        = wii
OPTIMIZE    = release

#ifdef DEBUG
COMPILER_FLAGS    += -g
OPTIMIZE    = debug
TARGET      = ../lib/wii/debug/libbdcore.a
#endif

OBJ_DIR     = $(DW_ROOT)/obj/$(PLAT)/$(OPTIMIZE)/bdCore
OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

SOURCE	    = bdCore.cpp bdContainers/bdBitBuffer.cpp bdContainers/bdByteBuffer.cpp bdContainers/bdHashMap.cpp bdContainers/bdSequenceNumber.cpp bdContainers/bdSequenceNumberStore.cpp bdContainers/bdSingleton.cpp bdCrypto/bdCryptoUtils.cpp bdCrypto/bdCypher.cpp bdCrypto/bdCypher3Des.cpp bdCrypto/bdECCKey.cpp bdCrypto/bdHash.cpp bdCrypto/bdHashTiger192.cpp bdCrypto/bdHMac.cpp bdCrypto/bdHMacSHA1.cpp bdCrypto/bdRSAKey.cpp bdMemory/bdAlignedOffsetMemory.cpp bdMemory/bdMallocMemory-wii.cpp bdMemory/bdMemory-wii.cpp bdMemory/bdMemory.cpp bdReference/bdReferencable.cpp bdSocket/bdAddr.cpp bdSocket/bdCommonAddr.cpp bdSocket/bdCommonAddrInfo.cpp bdSocket/bdEndpoint.cpp bdSocket/bdInetAddr.cpp bdSocket/bdMACAddr.cpp bdSocket/bdReceiveThread.cpp bdSocket/bdSecurityID.cpp bdSocket/bdSecurityInfo.cpp bdSocket/bdSecurityKey.cpp bdSocket/bdSendThread.cpp bdSocket/bdSocket.cpp bdSocket/bdStreamSocket.cpp bdSocket/bdTestSocket.cpp bdSocket/bdThreadedSocket.cpp bdSocket/bdThreadedStreamSocket.cpp bdString/bdString.cpp bdThread/bdMutex.cpp bdThread/bdRunnable.cpp bdThread/bdSemaphore.cpp bdThread/bdSignal.cpp bdThread/bdThread.cpp bdTiming/bdStopwatch.cpp bdUtilities/bdBase64.cpp bdUtilities/bdBitOperations.cpp bdUtilities/bdBytePacker.cpp bdUtilities/bdRandom.cpp bdUtilities/bdStringEscape.cpp bdUtilities/bdTrulyRandom.cpp 

OBJS        = $(SOURCE:.cpp=-wii.o)

TOOLS_DIR = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Tools/Command_Line_Tools/"
COMPILER_APP = mwcceppc.exe
LINKER_APP   = mwldeppc.exe
RM           = /bin/rm -f

all: .depend $(TARGET) .link $(TARGET)

clean:
	$(RM) $(TARGET) $(OBJS_ABSOLUTE)


$(TARGET): $(OBJS_ABSOLUTE)
	ar rcs $(TARGET) $(OBJS_ABSOLUTE)
	
$(OBJ_DIR)/%-wii-wii.o: %-wii.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*-wii.cpp -o $(OBJ_DIR)/$*-wii-wii.o

$(OBJ_DIR)/%-wii.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*.cpp -o $(OBJ_DIR)/$*-wii.o

.depend:
	$(TOOLS_DIR)$(COMPILER_APP) $(COMPILER_FLAGS) $(INCS) $(SOURCE)

.link:
	$(TOOLS_DIR)$(LINKER_APP) $(LINKER_FLAGS) $(OBJS_ABSOLUTE)
