# bdConnection

DW_ROOT	    ?= ..
WII_MSL_COMMON_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/MSL_Common/Include/"
WII_PPC_EABI_INCLUDES = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Support/MSL/MSL_C/PPC_EABI/Include"
WII_REVOLUTION_INCLUDES = "C:/RVL_SDK/include/"
WII_REVO_EX_INCLUDES = "C:/RevoEX/include/"
LIB_TOM_CRYPT_INCLUDES = $(DW_ROOT)"/external/libtomcrypt/src/headers"

INCS        =  -I$(DW_ROOT) -I$(WII_MSL_COMMON_INCLUDES) -I$(WII_PPC_EABI_INCLUDES) -I$(WII_REVOLUTION_INCLUDES) -I$(WII_REVO_EX_INCLUDES) -I$(LIB_TOM_CRYPT_INCLUDES)

COMPILER_FLAGS = -nodefaults -nolink -library -nosyspath -enum int -Cpp_exceptions off -fp hard  -DGEKKO -D_MSL_CLOCK_T_AVAILABLE -DRVL_OS
LINKER_FLAGS   = -nodefaults  -library -fp hard 


TARGET      = ../lib/wii/release/libbdconnection.a

PLAT        = wii
OPTIMIZE    = release

#ifdef DEBUG
COMPILER_FLAGS    += -g
OPTIMIZE    = debug
TARGET      = ../lib/wii/debug/libbdconnection.a
#endif

OBJ_DIR     = $(DW_ROOT)/obj/$(PLAT)/$(OPTIMIZE)/bdConnection
OBJS_ABSOLUTE	= $(OBJS:%=${OBJ_DIR}/%)

SOURCE	    = bdConnection.cpp bdConnectionListener.cpp bdConnectionStatistics.cpp bdConnectionStore.cpp bdConnectionStoreConfig.cpp bdLoopbackConnection.cpp bdUnicastConnection.cpp bdDispatch/bdDispatcher.cpp bdDispatch/bdDispatchInterceptor.cpp bdMessage/bdMessage.cpp bdMessage/bdReceivedMessage.cpp bdPacket/bdChunk.cpp bdPacket/bdCookie.cpp bdPacket/bdCookieAckChunk.cpp bdPacket/bdCookieEchoChunk.cpp bdPacket/bdDataChunk.cpp bdPacket/bdHeartbeatAckChunk.cpp bdPacket/bdHeartbeatChunk.cpp bdPacket/bdInitAckChunk.cpp bdPacket/bdInitChunk.cpp bdPacket/bdPacket.cpp bdPacket/bdSAckChunk.cpp bdPacket/bdShutdownAckChunk.cpp bdPacket/bdShutdownChunk.cpp bdPacket/bdShutdownCompleteChunk.cpp bdWindow/bdReliableReceiveWindow.cpp bdWindow/bdReliableSendWindow.cpp bdWindow/bdUnreliableReceiveWindow.cpp bdWindow/bdUnreliableSendWindow.cpp 

OBJS        = $(SOURCE:.cpp=-wii.o)

TOOLS_DIR = "C:/Program Files/Metrowerks/CW_RVL/PowerPC_EABI_Tools/Command_Line_Tools/"
COMPILER_APP = mwcceppc.exe
LINKER_APP   = mwldeppc.exe
RM           = /bin/rm -f

all: .depend $(TARGET) .link $(TARGET)

clean:
	$(RM) $(TARGET) $(OBJS_ABSOLUTE)


$(TARGET): $(OBJS_ABSOLUTE)
	ar rcs $(TARGET) $(OBJS_ABSOLUTE)
	
$(OBJ_DIR)/%-wii-wii.o: %-wii.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*-wii.cpp -o $(OBJ_DIR)/$*-wii-wii.o

$(OBJ_DIR)/%-wii.o: %.cpp
	if [ ! -d $(OBJ_DIR)/`dirname $*` ] ; then mkdir -p $(OBJ_DIR)/`dirname $*`; fi
	$(TOOLS_DIR)$(COMPILER_APP) $(INCS) -c $(COMPILER_FLAGS) $*.cpp -o $(OBJ_DIR)/$*-wii.o

.depend:
	$(TOOLS_DIR)$(COMPILER_APP) $(COMPILER_FLAGS) $(INCS) $(SOURCE)

.link:
	$(TOOLS_DIR)$(LINKER_APP) $(LINKER_FLAGS) $(OBJS_ABSOLUTE)
