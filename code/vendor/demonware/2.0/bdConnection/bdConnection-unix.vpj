<F N="bdDispatch/bdDispatcher.cpp"/>
<F N="bdDispatch/bdDispatcher.h"/>
<F N="bdDispatch/bdDispatchInterceptor.cpp"/>
<F N="bdDispatch/bdDispatchInterceptor.h"/>
</Folder>
<Folder Name = "bdMessage">
<F N="bdMessage/bdMessage.cpp"/>
<F N="bdMessage/bdMessage.h"/>
<F N="bdMessage/bdMessageFlags.h"/>
<F N="bdMessage/bdMessageTypes.h"/>
<F N="bdMessage/bdReceivedMessage.cpp"/>
<F N="bdMessage/bdReceivedMessage.h"/>
</Folder>
<Folder Name = "bdPacket">
<F N="bdPacket/bdChunk.cpp"/>
<F N="bdPacket/bdChunk.h"/>
<F N="bdPacket/bdCookie.cpp"/>
<F N="bdPacket/bdCookie.h"/>
<F N="bdPacket/bdCookieAckChunk.cpp"/>
<F N="bdPacket/bdCookieAckChunk.h"/>
<F N="bdPacket/bdCookieEchoChunk.cpp"/>
<F N="bdPacket/bdCookieEchoChunk.h"/>
<F N="bdPacket/bdDataChunk.cpp"/>
<F N="bdPacket/bdDataChunk.h"/>
<F N="bdPacket/bdDefaultPacket.h"/>
<F N="bdPacket/bdHeartbeatAckChunk.cpp"/>
<F N="bdPacket/bdHeartbeatAckChunk.h"/>
