IDD_PROGRESS DIALOGEX 0, 0, 310, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_FIXEDSYS | WS_CAPTION
EXSTYLE WS_EX_TOPMOST | WS_EX_TOOLWINDOW
CAPTION "Please wait..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,132,54,50,14
    CONTROL         "",IDC_PROGRESS_BAR,"msctls_progress32",WS_BORDER,6,30,300,14
    LTEXT           "",IDC_PROGESS_TEXT,7,7,299,17
END

IDD_TANGENT_SPACE_OPTIONS DIALOGEX 0, 0, 250, 202
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Calculate Tangents and Binormals"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_CTB_MAGSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_ARROWKEYS,168,30,11,14
    DEFPUSHBUTTON   "OK",IDOK,66,180,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,132,180,50,14
    LTEXT           "Angular tolerance",IDC_STATIC,18,54,58,8
    LTEXT           "Weld distance threshold",IDC_STATIC,18,121,78,8
    LTEXT           "Magnitude tolerance",IDC_STATIC,18,30,66,8
    EDITTEXT        IDC_CTB_MAGEDIT,126,30,42,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_CTB_ANGLESPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_ARROWKEYS,168,54,11,14
    EDITTEXT        IDC_CTB_ANGLEEDIT,126,54,42,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_WELDDISTANCESPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_ARROWKEYS,168,121,11,14
    EDITTEXT        IDC_CTB_WELDDISTANCE_EDIT,126,121,42,14,ES_AUTOHSCROLL
    CONTROL         "Normalise tangent space vectors",IDC_CTB_NORMALISECHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,78,121,10
    GROUPBOX        "Tangent Space Generation",IDC_STATIC,12,12,228,84
    GROUPBOX        "Mesh Welding",IDC_STATIC,12,108,228,60
    LTEXT           "(0..180 degs)",IDC_STATIC,186,54,45,8
    CONTROL         "Weld mesh prior to tangent space calculation",IDC_CTB_WELDMESHCHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,145,159,10
END

IDD_MESH_WELD_OPTIONS DIALOGEX 0, 0, 190, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mesh Welding"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,36,54,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,102,54,50,14
    GROUPBOX        "Mesh Welding",IDC_STATIC,6,6,180,36
    LTEXT           "Weld distance threshold",IDC_STATIC2,12,18,78,8
    CONTROL         "",IDC_MW_WELDDISTANCESPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_ARROWKEYS,162,18,11,14
    EDITTEXT        IDC_MW_WELDDISTANCE_EDIT,120,18,42,14,ES_AUTOHSCROLL
END

IDD_COMMAND_VIEW DIALOGEX 0, 0, 186, 95
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Go",IDOK,129,74,50,14
    EDITTEXT        IDC_COMMAND_VIEW_INPUT,7,74,117,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_COMMAND_VIEW_REDIT,"RichEdit20A",ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP,7,7,172,62
END


