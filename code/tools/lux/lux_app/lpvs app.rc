IDD_PROJECT_PREFERENCES_DIALOG DIALOGEX 0, 0, 412, 149
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Project Preferences"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,347,120,50,14
    DEFPUSHBUTTON   "OK",IDOK,287,120,50,14
    EDITTEXT        IDC_SCENE_FILE_EDIT,66,48,270,14,ES_AUTOHSCROLL
    LTEXT           "Input Scene:",IDC_STATIC,12,48,42,8
    PUSHBUTTON      "Browse...",IDC_SET_SCENE_FILE,348,48,50,14
    LTEXT           "Lighting Model:",IDC_STATIC,12,96,49,8
    EDITTEXT        IDC_LIGHTING_MODEL_EDIT,66,96,270,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_SET_LIGHTING_MODEL_FILE,348,96,50,14
    GROUPBOX        "Help",IDC_STATIC,12,6,390,30
    LTEXT           "Chose the file name of the scene to illuminate, the output scene, and the lighting model.",IDC_STATIC,18,19,283,8
    LTEXT           "Output Scene:",IDC_STATIC,12,72,48,8
    EDITTEXT        IDC_SCENE_OUTPUT_FILE_EDIT,66,72,270,14,ES_AUTOHSCROLL
