/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Project\tCtrl+N",        ID_FILE_NEW
        MENUITEM "&Open Project...\tCtrl+O",    ID_FILE_OPEN
        MENUITEM "&Save Project...\tCtrl+S",    ID_FILE_SAVE
        MENUITEM "Save Project &As...",         ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 57616, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    IDR_TOOLBARX
        MENUITEM "Tool&box",                    ID_VIEW_TOOLBOX
        MENUITEM "Debug &Output",               32790
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Realtime &Lighting",          ID_VIEW_REALTIMELIGHTING
        MENUITEM "Bounce &Paths",               ID_VIEW_BOUNCEPATHS
        MENUITEM "Show SH &Nodes",              ID_VIEW_SHOWSAMPLEPOINTS
        POPUP "Lightmap &Type"
        BEGIN
            MENUITEM "&Full Colour",                ID_LIGHTMAPTYPE_FULLCOLOUR
            MENUITEM "2-Channel &DXT1",             ID_LIGHTMAPTYPE_2
            MENUITEM "2-Channel &A8L8",             ID_LIGHTMAPTYPE_3
            MENUITEM "&Multiplied",                 ID_LIGHTMAPTYPE_MULTIPLIED
            MENUITEM "&Debug Unwrapping",           ID_LIGHTMAPTYPE_DEBUGUNWRAPPING
            MENUITEM "&Basis Hemisphere",           ID_LIGHTMAPTYPE_BUMPY
            MENUITEM "Vertex &SH",                  ID_LIGHTMAPTYPE_VERTEXSH
        END
    END
    POPUP "&Project"
    BEGIN
        MENUITEM "Project Settings...",         ID_PROJECT_PROJECTSETTINGS
    END
    POPUP "&Lighting"
    BEGIN
        MENUITEM "&Light Scene\tF5",            ID_LIGHTING_LIGHT
        MENUITEM "Lighting Model Settings...",  ID_LIGHTING_CONFIGURELIGHTINGMODEL
        MENUITEM "&Debug",                      ID_LIGHTING_DEBUG
        MENUITEM "Use &Network Rendering",      ID_LIGHTING_USENETWORKRENDERING
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About LPVS...",              ID_APP_ABOUT
    END
END


