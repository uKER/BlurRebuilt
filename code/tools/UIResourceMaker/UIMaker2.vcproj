					<Tool
						Name="VCCustomBuildTool"
						Description="Generating map file for help compiler..."
						CommandLine="echo // Generated Help Map file.  Used by $(ProjectName).hpj. &gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo. &gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo // Commands (ID_* and IDM_*) &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;makehm ID_,HID_,0x10000 IDM_,HIDM_,0x10000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo. &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo // Prompts (IDP_*) &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;makehm IDP_,HIDP_,0x30000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo. &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo // Resources (IDR_*) &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;makehm IDR_,HIDR_,0x20000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo. &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo // Dialogs (IDD_*) &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;makehm IDD_,HIDD_,0x20000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo. &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;echo // Frame Controls (IDW_*) &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;makehm IDW_,HIDW_,0x50000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\$(ProjectName).hm&quot;&#x0D;&#x0A;"
						Outputs="hlp\$(ProjectName).hm"
					/>
				</FileConfiguration>
				<FileConfiguration
