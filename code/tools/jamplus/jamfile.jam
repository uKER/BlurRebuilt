SubDir TOP Code Tools JamPlus ;

SupportedTargets WIN32_TOOL ;

IncludePath
$(SUBDIR)
$(TOP)/Code/Mercury/Library/Common/Core/include
$(TOP)/Code/Mercury/Library/Common/System/include
$(TOP)/Code/Mercury/Library/Util/Tools_Shared/include
$(TOP)/Code/Vendor/TClap/Current
;

Define NT OPT_ACTIONS_DUMP_TEXT_EXT OPT_ACTION_MAXTARGETS_EXT OPT_BUILTIN_MATH_EXT OPT_BUILTIN_MD5CACHE_EXT OPT_BUILTIN_MD5_EXT
OPT_BUILTIN_NEEDS_EXT OPT_BUILTIN_PUTENV_EXT OPT_BUILTIN_W32_GETREG_EXT OPT_BUILTIN_W32_SHORTNAME_EXT OPT_DEBUG_MAKE1_LOG_EXT
OPT_DEBUG_MAKE_PRINT_TARGET_NAME OPT_DEBUG_MEM_TOTALS_EXT OPT_EXPAND_FILEGLOB_EXT OPT_EXPAND_INCLUDES_EXCLUDES_EXT
OPT_EXPAND_LITERALS_EXT OPT_EXPAND_RULE_NAMES_EXT OPT_FIX_NOTFILE_NEWESTFIRST OPT_FIX_NT_ARSCAN_LEAK OPT_FIX_TEMPFILE_CRASH
OPT_FIX_UPDATED OPT_GRAPH_DEBUG_EXT OPT_HDRPIPE_EXT OPT_HDRRULE_BOUNDNAME_ARG_EXT OPT_HEADER_CACHE_EXT OPT_IMPROVED_MEMUSE_EXT
OPT_IMPROVED_PATIENCE_EXT OPT_IMPROVED_PROGRESS_EXT OPT_IMPROVED_WARNINGS_EXT OPT_IMPROVE_DEBUG_COMPILE_EXT
OPT_IMPROVE_DEBUG_LEVEL_HELP_EXT OPT_IMPROVE_JOBS_SETTING_EXT OPT_INTERRUPT_FIX OPT_JOB_SLOT_EXT OPT_MINUS_EQUALS_EXT
OPT_MULTIPASS_EXT OPT_NOCARE_NODES_EXT OPT_NODELETE_READONLY OPT_PATCHED_VERSION_VAR_EXT OPT_PATH_BINDING_EXT
OPT_PERCENT_DONE_EXT OPT_PIECEMEAL_PUNT_EXT OPT_PRINT_TOTAL_TIME_EXT OPT_RESPONSE_FILES OPT_ROOT_PATHS_AS_ABSOLUTE_EXT
OPT_SCAN_SUBDIR_NOTIFY_EXT OPT_SEMAPHORE OPT_SERIAL_OUTPUT_EXT2 OPT_SETCWD_SETTING_EXT OPT_SET_JAMPROCESSPATH_EXT
OPT_SLASH_MODIFIERS_EXT OPT_UPDATED_CHILD_FIX OPT_VAR_CWD_EXT dOPT_BUILTIN_LUA_SUPPORT_EXT LUAPLUS_DLL ;

if $(BUILD) = Speed
{
	CcFlags /O2 /Ob2 /Oi /Ot /Oy /GT /GL /FD /EHsc /GS- /arch:SSE2 /fp:fast ;
	LINKFLAGS += /RELEASE /OPT:REF /OPT:ICF /LTCG ;
}

SRC =
buffer.cpp
builtins.cpp
command.cpp
compile.cpp
execwin.cpp
expand.cpp
fileglob.cpp
fileglobbase.cpp
filent.cpp
glob.cpp
gnu_vc_errorconv.cpp
hash.cpp
hcache.cpp
headers.cpp
jam.cpp
jambase-j.cpp
jamgram.cpp
lists.cpp
make.cpp
make1.cpp
md5c.cpp
mempool.cpp
newstr.cpp
option.cpp
parse.cpp
pathunix.cpp
progress.cpp
redirect_output.cpp
regexp.cpp
rules.cpp
scan.cpp
search.cpp
timestamp.cpp
tmpunix.cpp
variable.cpp
w32_findperforce.cpp
w32_getperforceworkspace.cpp
w32_getreg.cpp
w32_shortname.cpp
jamplus.cpp
;

LinkLibraries jam : core system tools_shared ;

Application jam : source/$(SRC) ;
ExportVcproj jam ;

rule Checkout
{
	Depends $(<) : $(>) ;
	Depends all : $(<) ;
	_Checkout $(<) : $(>) ;
}

actions _Checkout
{
	echo Copying $(>:D=) to $(<:D)
	$(P4) edit $(<)
	copy "$(>:n)" "$(<:n)" >nul
	if exist $(>).manifest $(MT) -manifest $(>).manifest -outputresource:$(<:n);1
}

Checkout $(TOP)/bin/build_tools/jam.exe : jam.exe ;

SubInclude TOP Code Mercury Library Common Core ;
SubInclude TOP Code Mercury Library Common System ;
SubInclude TOP Code Mercury Library Util Tools_Shared ;
