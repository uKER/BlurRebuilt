
SubDir TOP Code Tools dialogueman ;

XENONSDK = [ ConvertDOSPath $(XEDK) ] ;

SupportedTargets WIN32_TOOL ;

ACTORSTUDIO_BRANCH = 1 ;

##Define UNICODE=1 _UNICODE=1 ;

##DEFINES += UNICODE _UNICODE ;

IncludePath
./source/
$(TOP)/code/mercury/library/common/core/include
$(TOP)/code/mercury/library/common/system/include
$(TOP)/code/mercury/library/common/misc_shared/include
$(TOP)/code/mercury/library/common/xt2/include
$(TOP)/code/mercury/library/common/xtwin/include
$(TOP)/code/mercury/library/util/tools_shared/include
$(TOP)/code/mercury/library/util/xt_shared/include
$(TOP)/code/mercury/library/util/xtwin_wx/include
$(TOP)/code/mercury/library/util/wx_shared/include
$(TOP)/code/tools/svn_wrapper/include
$(TOP)/code/tools/dialogueman/include
$(TOP)/code/vendor/sigslot/include
$(TOP)/libs/vendor/wxwidgets/2.8.6/include/msvc
$(TOP)/libs/vendor/wxwidgets/2.8.6/include/
$(TOP)/libs/vendor/wxwidgets/2.8.6/contrib/include
$(TOP)/libs/vendor/basicexcel/include
$(TOP)/libs/vendor/ms_speech_sdk/5.1/include
;

##Define
##OBJ_SHADERS
##;


##SUBDIRHDRS += \"$(DXSDK_PATH)/include\" ;
LINKLIBS += dbghelp.lib ws2_32.lib psapi.lib comctl32.lib rpcrt4.lib gdiplus.lib xbdm.lib sapi.lib Msimg32.lib ;
LINKFLAGS += /SUBSYSTEM:WINDOWS /MACHINE:X86 
	/LIBPATH:\"$(XEDK_PATH)/lib/win32/vs2005\"
	/LIBPATH:$(TOP)/code/tools/svn_wrapper/lib
	/LIBPATH:$(TOP)/libs/vendor/ms_speech_sdk/5.1/lib/i386
;
LINKFLAGS += "/NODEFAULTLIB:LIBC.lib" 
;

CCFLAGS += "/Zc:wchar_t-" ;	##without this MS Speech won't work

