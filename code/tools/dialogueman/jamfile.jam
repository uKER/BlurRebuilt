LinkLibraries DialogueMan :
	core system xttool xtwin tools_shared wxcore wxbase wxhtml wxaui wxcontrib wxregex wxtiff wxpng wxjpeg wxzlib wxadv xt_shared xtwin_wx basicexcel svn_wrapper wx_shared
;

Application DialogueMan : $(SRC) : stdafx.cpp ;

ExportVcproj DialogueMan ;

SubInclude TOP code mercury library common core ;
SubInclude TOP code mercury library common system ;
SubInclude TOP code mercury library common xt2 ;
SubInclude TOP code mercury library common xtwin ;
SubInclude TOP code mercury library util tools_shared ;
SubInclude TOP code mercury library util xt_shared ;
SubInclude TOP code mercury library util xtwin_wx ;
SubInclude TOP code mercury library util wx_shared ;
SubInclude TOP libs vendor wxwidgets 2.8.6 ;
SubInclude TOP libs vendor basicexcel ;
SubInclude TOP code tools svn_wrapper ;

Depends DialogueMan.exe : $(TOP)/bin/tools_wip/win32/dialogueman/ ;
MkDir $(TOP)/bin/tools_wip/win32/dialogueman/ ;

EmbedManifest $(TOP)/bin/tools_wip/win32/dialogueman/dialogueman.exe : DialogueMan.exe ;