<Window x:Class="FileTagManager3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FileTagManager3"
    xmlns:advanced="clr-namespace:FileTagManager3.LoadOnDemand"
        xmlns:menu="clr-namespace:MenuSystemLibrary;assembly=MenuSystemLibrary"
    Title="File Tag Manager 3 Alpha" Height="573" Width="1009.899" Loaded="Window_Loaded">
    <Window.Resources>
        <!--ObjectDataProvider x:Key="dataProvider" ObjectType="{x:Type local:AbDataSrc}" IsAsynchronous="True" ></ObjectDataProvider-->
    </Window.Resources>
        <Grid 
          
          Height="Auto" Width="Auto" 
          
          >
            
        <Grid Margin="10,40,10,10" Name="grid1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            <GridSplitter Name="gridSplitter1" Width="5" Grid.Column="0"/>

            <!--ListView Name="abListView" Grid.Column="1" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="Auto" Margin="0,0,5,0" ItemsSource="{Binding Source=ListViewDataSource.AbListFiles}"-->
            <ListView Name="abListView" Grid.Column="1" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="Auto" Margin="0,0,5,0" 
                    SelectionChanged="abListView_SelectionChanged"
                      GridViewColumnHeader.Click="abListView_Click"
                      
                      >
                <ListView.Style>
                    <Style TargetType="{x:Type ListView}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Yellow" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Filename" DisplayMemberBinding="{Binding Name, IsAsync=True}" Width="260"/>
                        <GridViewColumn Header="Local" DisplayMemberBinding="{Binding IsLocalFile, IsAsync=True}"/>
                        <GridViewColumn Header="Remote" DisplayMemberBinding="{Binding IsRemoteFile, IsAsync=True}"/>
                        <GridViewColumn Header="Locked" DisplayMemberBinding="{Binding IsLocked, IsAsync=True}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Name="gridSplitter2" Width="5" Grid.Column="1"/>
            <advanced:LoadOnDemandUserControl x:Name="abTreeView" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="Auto" Margin="0,0,5,0" TreeView.SelectedItemChanged ="abTreeView_SelectedItemChanged" >

                <advanced:LoadOnDemandUserControl.Style>
                    <Style TargetType="{x:Type advanced:LoadOnDemandUserControl}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Yellow" />
                            </Trigger>
                            <!--Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Black"></Setter>
                            </Trigger-->
                        </Style.Triggers>
                    </Style>
                </advanced:LoadOnDemandUserControl.Style>

            </advanced:LoadOnDemandUserControl>
            <my:WindowsFormsHost Grid.Column="2" Name="windowsFormsHost1" xmlns:my="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" >
                <menu:MenuSystem Width="200" Height="200"></menu:MenuSystem>

            </my:WindowsFormsHost>
        </Grid>
        <Button Height="23" HorizontalAlignment="Left" Margin="10,8,0,0" Name="buttonEdit" VerticalAlignment="Top" Width="75" Click="buttonEdit_Click">Edit</Button>
        <Button Height="23" HorizontalAlignment="Left" Margin="94.8,8,0,0" Name="buttonSubmit" VerticalAlignment="Top" Width="75" Click="buttonSubmit_Click" IsEnabled="False">Submit</Button>
        <Button Height="23" Margin="179.4,8,0,0" Name="buttonRevert" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75" Click="buttonRevert_Click" IsEnabled="False">Revert</Button>
    </Grid>
</Window>
