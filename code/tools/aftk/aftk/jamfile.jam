if $(TARGET) = WIN64_TOOL
{
	Library aftk : $(AFTKSRC) $(NATIVESRC) : stdafx.cpp ;
}
else
{
	if $(AFTK_MAYA) = 1
	{
		Define AFTK_MAYA_IO NT_PLUGIN AFTK_MAYA_IO_7_0 AFTK_FBX ;
	
		Library aftk_maya : <maya>$(AFTKSRC) <maya>$(NATIVESRC) <maya>$(MAYASRC) <maya>$(XSISRC) <maya>$(FBXSRC) : <maya>stdafx.cpp ;
	}
	else if $(AFTK_FBX) = 1
	{
		Define AFTK_FBX ;
		
		Library aftk_fbx : <fbx>$(AFTKSRC) <fbx>$(NATIVESRC) <fbx>$(XSISRC) <fbx>$(FBXSRC) : <fbx>stdafx.cpp ;	
	}
	else
	{
		Library aftk : $(AFTKSRC) $(NATIVESRC) $(XSISRC) : stdafx.cpp ;
	}
}

ExportVcproj aftk ;
