<Window x:Class="AmaxReproBuddy.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amax Repro Buddy" Height="372" Width="365">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0">Event:</TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0">Retries:</TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0">Laps:</TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="0">Quit Race After (secs):</TextBlock>

                <TextBox Grid.Row="0" Grid.Column="1"></TextBox>
                <TextBox Grid.Row="1" Grid.Column="1"></TextBox>
                <TextBox Grid.Row="2" Grid.Column="1"></TextBox>
                <TextBox Grid.Row="3" Grid.Column="1"></TextBox>
            </Grid>

            <CheckBox DockPanel.Dock="Top">Run Until Problem (ignore retry limit)</CheckBox>

            <GroupBox DockPanel.Dock="Top" Header="Run Options">
                <StackPanel>
                    <RadioButton Name="radioUseDebugSetup" IsChecked="True">Use Current Debug Race</RadioButton>
                    <RadioButton Name="radioUseEventId">Run Selected Event</RadioButton>
                </StackPanel>
            </GroupBox>

            <GroupBox DockPanel.Dock="Top" Header="Race Options">
                <StackPanel>
                    <RadioButton IsChecked="True">Quit After Time</RadioButton>
                    <RadioButton>Quit After Laps</RadioButton>
                    <RadioButton>Never Quit</RadioButton>
                </StackPanel>
            </GroupBox>

            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
            
                <Button Grid.Column="1" Click="Button_Click" Name="buttonGo">GO!</Button>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
