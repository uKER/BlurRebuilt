##Define
##OBJ_SHADERS
##;


SUBDIRHDRS += \"$(DXSDK)/include\" ;
LINKLIBS += dbghelp.lib dxerr.lib d3d9.lib d3dx9.lib ws2_32.lib dinput8.lib dxguid.lib psapi.lib opengl32.lib glu32.lib xsiftk.lib devil_win32_dynamic_2005.lib comctl32.lib rpcrt4.lib xbdm.lib gdiplus.lib msimg32.lib CubeMapGenLib.lib ;
LINKLIBS += python26.lib ;

LINKFLAGS += /SUBSYSTEM:WINDOWS /MACHINE:X86 
	/LIBPATH:\"$(DXSDK)/lib/x86\" 
	/LIBPATH:\"$(XEDK_PATH)/lib/win32/vs2005\"
	/LIBPATH:$(TOP)/libs/vendor/xsiftk/5.11/lib 
	/LIBPATH:$(TOP)/libs/vendor/devil/1.6.7-mercury/lib 
	/LIBPATH:$(TOP)/libs/vendor/ati_cubemapgen/lib 
	/LIBPATH:$(TOP)/code/vendor/python/2.6/
;

##disable incremental linking for smaller exes
if $(BUILD) = Release
{
	## why can't I do this...
	##INCREMENTAL_LINKING = 0 ;
	## or this
	##LINKFLAGS -= /INCREMENTAL ;
	
	for f in $(LINKFLAGS)
	{
		if $(f) != /INCREMENTAL
		{
			NEWLINKFLAGS += $(f) ;
		}
	}
	
	LINKFLAGS = $(NEWLINKFLAGS) ;
	LINKFLAGS += /RELEASE /OPT:REF /OPT:ICF ;
}

LINKFLAGS += /FIXED:NO ;

