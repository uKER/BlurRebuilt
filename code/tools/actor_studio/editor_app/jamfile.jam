SHADERSRC = 
[ Shader ./source/editorapp/editor/shaders/vsInstance.vsh : "<Wireframe> -DWIREFRAME" ]
[ Shader ./source/editorapp/editor/shaders/vsInstance.vsh : "<Solid> -DSOLID" ]
[ Shader ./source/editorapp/editor/shaders/psInstance.psh : "<Wireframe> -DWIREFRAME" ]
[ Shader ./source/editorapp/editor/shaders/psInstance.psh : "<Solid> -DSOLID" ]
[ Shader ./source/editorapp/editor/shaders/psInstance.psh : "<SolidLit> -DSOLID -DLIT" ]
[ Shader ./source/editorapp/editor/shaders/vsSprite.vsh : "<Solid> -DSOLID" ]
[ Shader ./source/editorapp/editor/shaders/psSprite.psh : "<Solid> -DSOLID" ]
[ Shader ./source/editorapp/editor/shaders/psSprite.psh : "<SolidGreyScale> -DSOLID -DGREYSCALE" ]
[ Shader ./source/editorapp/editor/shaders/vsSprite.vsh : "<SolidDepthBias> -DSOLID -DDEPTHBIAS" ]
[ Shader ./source/editorapp/editor/shaders/psSprite.psh : "<SolidDepthBias> -DSOLID -DDEPTHBIAS" ]
[ Shader ./source/editorapp/editor/shaders/psSprite.psh : "<SolidGreyScaleDepthBias> -DSOLID -DGREYSCALE -DDEPTHBIAS" ]
;

SRC += $(SHADERSRC) ;

ImportCP render/shaders/vsConstants.h : TOP Code Mercury Library Graphics Render ;
ImportCP render/shaders/psConstants.h : TOP Code Mercury Library Graphics Render ;
CPFile ./source/editorapp/editor/shaders/psConstants.cp ;
CPFile ./source/editorapp/editor/shaders/vsConstants.cv ;

LinkLibraries Editor :
	core system gravity xttool xtwin xtwin_wx xt_shared misc_shared tools_shared display display2 render aftk aftkutlib attk backend_lib usernode_lib usercmd_lib python_lib aftkrender wxadv wxcore wxbase wxaui wxcontrib wxregex wxtiff wxpng wxjpeg wxzlib file_tag_db svn_wrapper ab_wrapper actor_studio_msg_shared
;
		
Application Editor : $(SRC) : stdafx.cpp ;

ExportVcproj Editor ;

SubInclude TOP code mercury library common core ;
SubInclude TOP code mercury library common system ;
SubInclude TOP code mercury library common xt2 ;
SubInclude TOP code mercury library common xtwin ;
