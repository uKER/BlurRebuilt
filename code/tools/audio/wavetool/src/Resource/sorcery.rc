    "S",            ID_FILE_SAVEPROJECT,    VIRTKEY, CONTROL, NOINVERT
    "G",            ID_GOTO_RECORD,         VIRTKEY, CONTROL, NOINVERT
    VK_F11,         ID_HELP_RELOADSCHEMA,   VIRTKEY, NOINVERT
    VK_F7,          ID_TOOLS_BUILDPROJECT,  VIRTKEY, NOINVERT
    VK_F7,          ID_TOOLS_BUILDPROJECT_DATAONLY, VIRTKEY, SHIFT, NOINVERT
    VK_F7,          ID_TOOLS_BUILDPROJECT_NODEPLOY, VIRTKEY, CONTROL, NOINVERT
    VK_F2,          ID_TOOLS_CONNECTTO,     VIRTKEY, CONTROL, NOINVERT
    VK_F8,          ID_DEBUG_TRANSFEROPENRECORDS, VIRTKEY, NOINVERT
END


