IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Import...",                   ID_FILE_IMPORT
        MENUITEM "Export...",                   ID_FILE_EXPORT
        MENUITEM "Export Selection...",         ID_FILE_EXPORTSELECTION
        , GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT, INACTIVE
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        , INACTIVE
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        , INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO, INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT, INACTIVE
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY, INACTIVE
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE, INACTIVE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_Menu
        MENUITEM "&Output Window",              ID_VIEW_OUTPUTWINDOW
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        POPUP "Show / Hide Nodes"
        BEGIN
            MENUITEM "Meshes",                      ID_SHOW_MESHES
            MENUITEM "Splines",                     ID_SHOW_SPLINES
            MENUITEM "Instances",                   ID_SHOW_INSTANCES
            MENUITEM "Point Lights",                ID_SHOW_POINTLIGHTS
            MENUITEM "Spot Lights",                 ID_SHOW_SPOTLIGHTS
            MENUITEM "Directional Lights",          ID_SHOW_DIRECTIONALLIGHTS

            MENUITEM "Joints",                      ID_SHOW_JOINTS
        END
        MENUITEM "Show Grid",                   ID_VIEW_SHOWGRID
    END
    POPUP "Shading"
    BEGIN
        MENUITEM "Wireframe All",               ID_SHADING_WIREFRAMEALL
        MENUITEM "Smooth Shade All",            ID_SHADING_SMOOTHSHADEALL
        MENUITEM "Points All",                  ID_SHADING_POINTSALL
        MENUITEM "Bounding Box All",            ID_SHADING_BOUNDINGBOX
        , INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "Backface Culling",            ID_SHADING_BACKFACECULLING
        MENUITEM "Texturing",                   ID_SHADING_TEXTURING
        MENUITEM "Show Weighting",              ID_SHADING_SHOWWEIGHTING
        MENUITEM SEPARATOR
        MENUITEM "Fixed Function Skinning",     ID_SHADING_FIXEDFUNCTIONSKINNING

        MENUITEM "Shader Skinning",             ID_SHADING_SHADERSKINNING
        , INACTIVE
    END
    POPUP "Lighting"
    BEGIN
        MENUITEM "Default Lighting",            ID_LIGHTING_DEFAULTLIGHTING
        MENUITEM "Use All Lights",              ID_LIGHTING_USEALLLIGHTS
        , INACTIVE
    END
    POPUP "Rendering"
    BEGIN
        MENUITEM "Vertex Normals",              ID_RENDERING_VERTEXNORMALS
        MENUITEM "Axes",                        ID_RENDERING_AXES
        MENUITEM SEPARATOR
        POPUP "Lightmap &Type"
        BEGIN
            MENUITEM "&Full Colour",                ID_LIGHTMAPTYPE_FULLCOLOUR

            MENUITEM "2-Channel &DXT1",             ID_LIGHTMAPTYPE_2
            MENUITEM "2-Channel A8L8",              ID_LIGHTMAPTYPE_3
            MENUITEM "Multiplied",                  ID_LIGHTMAPTYPE_MULTIPLIED

        END
    END
    POPUP "Debug"
    BEGIN
        MENUITEM "Output Scene Graph",          ID_DEBUG_OUTPUTSCENEGRAPH
        MENUITEM "Calculate &VIS\tF5",          ID_DEBUG_CALCULATEVIS
        MENUITEM "Show Cell...",                ID_DEBUG_SHOWCELL
        MENUITEM "Load Database...",            ID_DEBUG_LOADDATABASE
        MENUITEM "Show &Usage",                 ID_DEBUG_SHOWUSAGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Vis...",               ID_APP_ABOUT
    END
END


