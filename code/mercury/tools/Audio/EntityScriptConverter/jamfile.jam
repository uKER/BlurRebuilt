SubDir TOP Code Mercury Tools Audio EntityScriptConverter ;

SupportedTargets WIN32_TOOL ;

MERCURY = $(TOP)/Code/Mercury/Library ;

IncludePath
.
./include
./EntityScriptConverter$(PLATFORM)
$(MERCURY)/Common/Core/include
$(MERCURY)/Common/System/include
$(MERCURY)/Common/Xt2/include
$(MERCURY)/Common/Xt2/Source
;

SRC =
./Main.cpp
#./SorceryIntegration.cpp
;

LinkLibraries EntityScriptConverter :
		core system xttool
		;
		
SUBDIRHDRS += \"$(DXSDK_PATH)/include\" ;
LINKFLAGS = /SUBSYSTEM:WINDOWS /MACHINE:X86 /DEBUG ;

PCLIBS =
ws2_32.lib dbghelp.lib psapi.lib user32.lib advapi32.LIB gdi32.lib
;

LINKLIBS = $($(PLATFORM)LIBS) ;


Application EntityScriptConverter : $(SRC) ;
ExportVcproj EntityScriptConverter ;

SubInclude TOP Code Mercury Library Common Core ;
SubInclude TOP Code Mercury Library Common System ;
SubInclude TOP code Mercury Library Common xt2 ;

Copy $(BIZARRE_ROOT)/tools/common_tools/win32/audio_entityscriptconverter : EntityScriptConverter.exe ;
Copy $(BIZARRE_ROOT)/tools/common_tools/win32/audio_entityscriptconverter : $(TOP)/code/mercury/tools/Audio/EntityScriptConverter/bin/win32_tool/$(BUILD)/EntityScriptConverter.exe.manifest ;
Copy $(BIZARRE_ROOT)/tools/common_tools_wip/win32/audio_entityscriptconverter : EntityScriptConverter.exe ;
Copy $(BIZARRE_ROOT)/tools/common_tools_wip/win32/audio_entityscriptconverter : $(TOP)/code/mercury/tools/Audio/EntityScriptConverter/bin/win32_tool/$(BUILD)/EntityScriptConverter.exe.manifest ;


