<!-- **************** -->
<!-- Shader Fragments -->
<!-- **************** -->

<Fragment name = "Default" >
	<Condition type ="Required" id = "Def"/>
  <!-- <Condition type "Exclude" id "SomeId"/> -->
  <!-- <Condition type "Mutex" id "SomeOtherFragment"/> -->
</Fragment>

<Fragment name = "Textured" >
	<Condition type ="Required" id= "Tex"/>

	<Define name = "UseAlbedo" />
</Fragment>

<Fragment name = "CubeMap" >
	<Condition type ="Required" id= "Cub"/>

	<Define name = "UseCubeMap" />
</Fragment>

<Fragment name = "Highlight" >
	<Condition type ="Required" id= "Hlt"/>

	<Define name = "UseHighlight" />
</Fragment>

<Fragment name = "NormalMap" >
	<Condition type ="Required" id= "Nrm"/>

	<Define name = "UseNormalMap" />
</Fragment>

<Fragment name = "Emissive" >
	<Condition type ="Required" id = "Emi"/>

	<Define name = "UseEmissive" />
</Fragment>

<Fragment name = "Night_Emissive">

	<Condition type ="Required" id = "NEm"/>
  <Condition type ="Mutex" id = "Night_Emissive"/>
  <Condition type ="Mutex" id = "Skinned"/>

  <Define name = "UseNightEmissive" />
</Fragment>

<Fragment name = "SkinShader" >
	<Condition type ="Required" id= "Ski"/>

  <Condition type ="Exclude" id= "LightMp"/>
  <Condition type ="Exclude" id= "Lmp"/>

  <Define name = "UseAlbedo" />
	<Define name = "UseCubeMap" />
  <Define name = "UseHighlight" />
	<Define name = "UseNormalMap" />
	<Define name = "UseSkinShader" />
</Fragment>
<Fragment name = "Fabric">
	<Condition type ="Required" id= "Fab"/>

	<Define name = "UseAlbedo" />
  <Define name = "UseCubeMap" />
  <Define name = "UseHighlight" />
  <Define name = "UseNormalMap" />
  <Define name = "UseFabricShader" />
</Fragment>

<Fragment name = "Eye" >
  <Condition type ="Required" id= "Eye"/>

  <Condition type ="Exclude" id= "LightMp"/>
  <Condition type ="Exclude" id= "Lmp"/>

  <Define name = "UseAlbedo" />
  <Define name = "UseCubeMap" />
  <Define name = "UseHighlight" />
	<Define name = "UseNormalMap" />
	<Define name = "UseEyeShader" />
</Fragment>

<Fragment name = "Flo" >
  <Condition type ="Required" id= "Flo"/>
  <Condition type ="Required" id= "LightMp"/>

  <Condition type ="Mutex"    id= "Skinned"/>

  <Condition type ="Mutex"    id= "Flo"/>

  <Define name = "UseAlbedo" />
  <Define name = "UseCubeMap" />
  <Define name = "UseHighlight" />
  <Define name = "UseNormalMap" />
  <Define name = "UseFlowShader" />
</Fragment>


<Fragment name = "Glow" >
	<Condition type ="Required" id= "Glo"/>

  <Define name = "UseAlbedo" />
  <Define name = "UseGlowLighting" />
</Fragment>

<Fragment name = "SunGlow" >
	<Condition type ="Required" id= "Sun"/>
  <Condition type ="Mutex"    id= "Skinned"/>

  <Define name = "UseAlbedo" />
	<Define name = "UseSunglowLighting" />
</Fragment>

<Fragment name = "Default_Lighting" >
  <Condition type ="Required" id= "LightDe"/>

  <Define name ="UseDefaultLighting" />
</Fragment>

<Fragment name = "Default_Lighting2" >
  <Condition type ="Required" id= "LightMp"/>
  <Condition type ="Required" id= "LDe"/>

  <Define name ="UseDefaultLighting" />
</Fragment>

<Fragment name = "SH_Lighting" >
	<Condition type ="Required" id= "LightSh"/>

	<Define name ="UseSHLighting" />
</Fragment>

<Fragment name = "Lightmap_Lighting" >
  <Condition type ="Required" id= "LightMp"/>
  <Condition type ="Required" id= "Lmp"/>
  
  <Condition type ="Mutex"    id= "Skinned"/>
  <Condition type ="Mutex"    id= "Glow"/>
  <Condition type ="Mutex"    id= "SunGlow"/>

  <Define name ="UseLightmapLighting" />
</Fragment>

<Fragment name = "Scaled">
	<Condition type ="Required" id= "Sca"/>

	<Define name = "UseScale" />
</Fragment>

<Fragment name = "Skinned">
	<Condition type ="Required" id= "Skn"/>

	<Define name = "UseSkinnedMesh" />
</Fragment>

<Fragment name = "PointLights1">
  <Condition type ="Required" id= "Pl1"/>
  <Condition type ="Mutex" id= "Glow"/>
  <Condition type ="Mutex" id= "SunGlow"/>

  <Define name = "PointLights1" />
</Fragment>

<Fragment name = "PointLights4">
  <Condition type ="Required" id= "Pl4"/>
