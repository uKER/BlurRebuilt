SubDir TOP Code Mercury Applications Physics Gravity Exporter ;

SupportedTargets WIN32_TOOL ;

IncludePath 
$(TOP)/Code/Mercury/Library/Common/Core/include
$(TOP)/Code/Mercury/Library/Common/Misc_Shared/include
$(TOP)/Code/Mercury/Library/Common/System/include
$(TOP)/Code/Mercury/Library/Common/Btl/include
$(TOP)/Code/Mercury/Library/Physics/Gravity/include
$(TOP)/Code/Tools/aftk/aftk/Include
$(TOP)/code/tools/aftkut/AftkUtLib/include
$(TOP)/Code/Common/
;


USE_SOLVER2 = 1 ;

if $(USE_SOLVER2) != 1
{
echo define solver 1 ;
}
else
{
echo define solver 2 ;
	Define USE_SOLVER_2 ;
}

LINKLIBS +=  ws2_32.lib ;

SRC = 
Test.cpp
Converter.cpp
ConvertA3D.cpp
;

#CcFlags /showIncludes ;

LinkLibraries GravityExporter : core system gravity misc_shared aftk aftkutlib zlib $(TOP)/libs/vendor/xsiftk/5.11/lib/xsiftk ;

Application GravityExporter : $(SRC) ;
ExportVcproj GravityExporter ;

SubInclude TOP Code Mercury Library Common Core ;
SubInclude TOP Code Mercury Library Common System ;
SubInclude TOP Code Mercury Library Physics Gravity ;
SubInclude TOP Code Mercury Library Common Misc_Shared ;
SubInclude TOP Code Tools Aftk Aftk ;
SubInclude TOP Code Tools aftkut aftkutlib ;
SubInclude TOP Code Vendor ZLib current_mercury ;
