DEMONWARE_SRC = 
$(BD_CONNECTION)
$(BD_CORE_$(PLATFORM))
$(BD_EXAMPLE_COMMON_LOBBY_$(PLATFORM))
$(BD_LOBBY_$(PLATFORM))
;

DEMONWARE_LIBS =  
bdSocket 
bdPlatform 
bdNet 
;

DEMONWARE_ENCRYPTION_LIBS = 
libtomcrypt 
libtommath 
;

if $(BUILD) = Master || $(BUILD) = Speed || $(BUILD) = Profile || $(BUILD) = Release
{
	if $(PLATFORM) = PS3
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/ps3-sn/release/$(DEMONWARE_LIBS).lib ;
	 	LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/ps3-sn/release/$(DEMONWARE_ENCRYPTION_LIBS).a ;
	}
	if $(PLATFORM) = PC
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/win32-vs8/release-mt/$(DEMONWARE_LIBS).lib ;
	 	LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/win32-vs8/release-mt/$(DEMONWARE_ENCRYPTION_LIBS).lib ;
	}
	if $(PLATFORM) = XENON
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/xenon-vs8/release/$(DEMONWARE_LIBS).lib ;
	}
}
else
{
	if $(PLATFORM) = PS3
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/ps3-sn/debug/$(DEMONWARE_LIBS).lib ;
	 	LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/ps3-sn/debug/$(DEMONWARE_ENCRYPTION_LIBS).a ;
	}
	if $(PLATFORM) = PC
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/win32-vs8/debug-mt/$(DEMONWARE_LIBS).lib ;
	 	LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/win32-vs8/debug-mt/$(DEMONWARE_ENCRYPTION_LIBS).lib ;
	}
	if $(PLATFORM) = XENON
	{
		LINKLIBS += $(TOP)/code/vendor/demonware/1.9/lib/xenon-vs8/debug/$(DEMONWARE_LIBS).lib ;
	}
}