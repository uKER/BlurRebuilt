SubDir TOP Code Mercury Applications Samples Environmental ;

SupportedTargets WIN32 PS3 XBOX_360 ;

MERCURY = $(TOP)/Code/Mercury/Library ;

IncludePath
./include
$(MERCURY)/Common/Btl/include
$(MERCURY)/Common/Core/include
$(MERCURY)/Common/System/include
$(MERCURY)/Graphics/Display/include
$(MERCURY)/Graphics/Dynamic/include
$(MERCURY)/Graphics/Effect/include
$(MERCURY)/Graphics/Render/include
$(MERCURY)/Samples/include
$(MERCURY)/Common/Misc_Shared/include
$(MERCURY)/Common/Xt2/include
;

SRC =
./Main.cpp
$(MERCURY)/samples/source/GameFunctionality.cpp
$(MERCURY)/samples/source/section/SectionSky.cpp
$(MERCURY)/samples/source/section/SectionFog.cpp
$(MERCURY)/samples/source/section/SectionFFTOcean.cpp
$(MERCURY)/samples/source/section/SectionWaveEquation.cpp
$(MERCURY)/samples/source/section/SectionRain.cpp
;

LinkLibraries Environmental :
		core system display dynamic effect render zlib samples misc_shared xtgame
		;
		
if $(PLATFORM) = PC
{
SUBDIRHDRS += \"$(DXSDK_PATH)/include\" ;
LINKLIBS += ws2_32.lib dbghelp.lib psapi.lib "$(DXSDK_PATH)/Lib/x86/d3d9.lib" "$(DXSDK_PATH)/Lib/x86/d3dx9.lib" "$(DXSDK_PATH)/Lib/x86/dinput8.lib" "$(DXSDK_PATH)/Lib/x86/dxguid.lib" "$(DXSDK_PATH)/Lib/x86/dxerr.lib" ;
LINKFLAGS += /SUBSYSTEM:WINDOWS /MACHINE:X86 /DEBUG ;
}

XenonRemoteLocation environmental ;

Application Environmental : $(SRC) ;
ExportVcproj Environmental ;

SubInclude TOP Code Mercury Library Common Btl ;
SubInclude TOP Code Mercury Library Common Core ;
SubInclude TOP Code Mercury Library Common System ;
SubInclude TOP Code Mercury Library Graphics Display ;
SubInclude TOP Code Mercury Library Graphics Dynamic ;
SubInclude TOP Code Mercury Library Graphics Effect ;
SubInclude TOP Code Mercury Library Graphics Render ;
SubInclude TOP Code Mercury Library Samples ;
SubInclude TOP Code Mercury Library Common Misc_Shared ;
SubInclude TOP Code Mercury Library Common Xt2 ;
SubInclude TOP Code Vendor zlib current_mercury  ;



