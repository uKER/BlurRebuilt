SubDir TOP Code Mercury Library Audio ;

Define USE_XAUDIO2 ;

if $(USERNAME) = nbygrave || $(USERNAME) = jcutter || $(USERNAME) = coflanagan || $(USERNAME) = shall || $(USERNAME) = orenault
{
	Define AUDIO_BUILD ;
	
	if $(BUILD) != Speed && $(BUILD) != Master
	{
		# comment out this to turn optimizations on
		#OPTIMIZE_OFF = 1 ;
	}

	if $(OPTIMIZE_OFF) = 1
	{
		Optim Off ;
		#Define AUDIO_OPTIMIZE_OFF ;
		echo OPTIMISATIONS ARE _OFF_ FOR AUDIO LIBRARY ;
	}
} 

MERCURY = $(TOP)/Code/Mercury/Library ;

IncludePath
$(SUBDIR)/include
$(MERCURY)/common/core/include
$(MERCURY)/common/system/include
$(MERCURY)/common/Xt2/include
$(MERCURY)/util/resource/include
;

if $(PLATFORM) = PC
{
	IncludePath $(TOP)/libs/vendor/openal/1.1/include \"$(DXSDK_PATH)/include\" ;
}

