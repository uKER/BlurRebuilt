SRC_2 = 
;

SRC = [ Batch $(SRC) : AudioPch.h ] $(SRC_2) ;


PCSRC =
./source/core/engine_pc.cpp
;

PS3SRC =
# ./source/core/MP3Decode.cpp
;

#SrcOptim ./source/core/filestream.cpp : Off ;
#SrcOptim ./source/core/MP3Decode.cpp : Off ;
#SrcOptim ./source/core/renderer.cpp : Off ;
#SrcOptim ./source/core/dspdelay.cpp : Off ;
#SrcOptim ./source/core/decoderxma.cpp : Off ;

if $(PLATFORM) = PS3
{
AdditionalObjects audio : audio_spu_ps3 ;
}

SPUSRCPATH = ./source ;

SPUSRC =
<spu>$(SPUSRCPATH)/BatchFrameAdd.cpp
;

#SrcOptim <spu>$(SPUSRCPATH)/BatchFrameAdd.cpp : Off ;

if $(PLATFORM) = PS3
{
AddSPUModule audio : AudioBatchFrameAddSPU		: $(SPUSRC) ;
}


Library audio : $(SRC) $($(PLATFORM)SRC) : AudioPch.cpp : AudioPch.h ;

if $(PLATFORM) = PS3
{
SubInclude TOP Code Mercury Library Audio SPU ;
SubInclude TOP Code Mercury Library Common System ;
}

