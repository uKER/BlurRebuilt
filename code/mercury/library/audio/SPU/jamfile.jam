Define AUDIO_SPU ;
Define OVERRIDE_SPU_ALLOCS ;

#SRC += <OVL1>$(OVL0SRC) <OVL2>$(OVL1SRC) ;
SRC += $(OVL0SRC) $(OVL1SRC) ;

SrcOptim $(SRC) : "-Os" ;
#SrcOptim ../source/Object.cpp : "-O0" ;
#SrcOptim ../source/Definition.cpp : Off ;
#SrcOptim ../source/InstanceUpdate.cpp : Off ;
#SrcOptim ../source/core/decoderpcms16.cpp : Off ;
SrcOptim ../source/core/decoderadpcm4bit.cpp : "-O2" ; 
#SrcOptim ../source/core/Mixer.cpp : "-O2" ; 
#SrcOptim ../source/core/wave.cpp  : "-O2" ; 

LinkLibraries audio_spu_ps3 : $(SCE_PS3_ROOT)/target/spu/lib/libm.a ;

# use a linker script and a custom commandline to link the SPU program with overlays
SPUModule audio_spu_ps3 : $(SRC) ;

#Depends all : audio_spu_ps3.self ;

