				CommandLine="cd &quot;$(TargetDir)&quot;&#x0D;&#x0A;md &quot;..\..\..\..\bin\spu\$(ConfigurationName)&quot; &gt;nul&#x0D;&#x0A;copy &quot;$(TargetPath)&quot; &quot;..\..\..\..\bin\spu\$(ConfigurationName)\&quot; &gt;nul&#x0D;&#x0A;copy &quot;$(TargetPath)&quot; &quot;$(TargetPath)2&quot; &gt;nul&#x0D;&#x0A;spu-lv2-strip &quot;$(TargetPath)&quot; -o &quot;$(TargetPath)_stripped&quot;&#x0D;&#x0A;copy &quot;$(TargetPath)_stripped&quot; &quot;$(TargetPath)&quot; &gt;nul&#x0D;&#x0A;ppu-lv2-objcopy -I binary -O elf64-powerpc-celloslv2 -B powerpc --set-section-align .data=7 --set-section-pad .data=128 --rename-section .data=.spu_image.spu/$(TargetFileName) --redefine-sym _binary_$(TargetName)_elf_start=_binary_spu_$(TargetName)_elf_start --redefine-sym _binary_$(TargetName)_elf_end=_binary_spu_$(TargetName)_elf_end --redefine-sym _binary_$(TargetName)_elf_size=_binary_spu_$(TargetName)_elf_size &quot;$(TargetFileName)&quot; &quot;$(TargetName).ppu.obj&quot;&#x0D;&#x0A;copy &quot;$(TargetPath)2&quot; &quot;$(TargetPath)&quot; &gt;nul&#x0D;&#x0A;"
