				Name="VCCLCompilerTool"
				AdditionalOptions="-Wall -fno-exceptions -O2 -g"
				Optimization="2"
				AdditionalIncludeDirectories="&quot;$(SN_PS3_PATH)\spu\include\sn&quot;;&quot;$(SCE_PS3_ROOT)\target\spu\include&quot;;&quot;$(SCE_PS3_ROOT)\target\common\include&quot;;..\..\system\include;..\..\core\include;..\include;..\source"
				PreprocessorDefinitions="SN_TARGET_PS3_SPU;NDEBUG;__GCC__;SPU;BUILD_CONFIG_RELEASE;PLATFORM_SPU;AUDIO_GENERATORS_NOT_OVERLAID;AUDIO_SPU"
				ProgramDataBaseFileName="$(IntDir)\"
				DebugInformationFormat="0"
				CompileAs="0"
				ForcedUsingFiles=""
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCPreLinkEventTool"
				CommandLine="$(SCE_PS3_ROOT)\host-win32\bin\cellOvisMkLdscript --spurs $(ProjectDir)\ovis_audio_config_generators_not_overlaid.xml &gt; $(IntDir)\ovly_ldscript.ld&#x0D;&#x0A;cd $(IntDir)&#x0D;&#x0A;$(SCE_PS3_ROOT)\host-win32\spu\bin\spu-lv2-gcc.exe -Wl,-Map=&quot;z:\spu\audio\audio.map&quot; -Tovly_ldscript.ld dspeffect.obj decoderadpcm4bit.obj decoderpcms16.obj input.obj output.obj mixer.obj 3dmaths.obj dspdelay.obj dspgain.obj dspiirhighpass1storder.obj dspiirhighshelf.obj dspiirlowpass1storder.obj dspiirlowpass2ndorder.obj dspiirlowshelf.obj dspiirpeakeq.obj dsplipsync.obj dsppeaklevel.obj dspphaser.obj dsprmslevel.obj dspsaturator.obj dspcompressor.obj dspfeedbackdelay.obj Component.obj ComponentContainer.obj core.obj decoder.obj Definition.obj Instance.obj main.obj Object.obj SystemSPU.obj Util.obj -lspurs -lovis -latomic -o audio_SPU_ps3.elf&#x0D;&#x0A;"
			/>
			<Tool
				Name="VCLinkerTool"
				LinkLibraryDependencies="false"
				AdditionalOptions="-Wl,-Map=&quot;z:\spu\audio\audio.map&quot; -c -T$(IntDir)\ovly_ldscript.ld -L$(IntDir)"
				AdditionalDependencies="&quot;$(SCE_PS3_ROOT)\target\spu\lib\libspurs.a&quot; &quot;$(SCE_PS3_ROOT)\target\spu\lib\libdma.a&quot; &quot;$(SCE_PS3_ROOT)\target\spu\lib\libovis.a&quot;"
				OutputFile="$(OutDir)/$(ProjectName).elf"
				LinkIncremental="0"
				AdditionalLibraryDirectories=""
				GenerateManifest="false"
				ProgramDatabaseFile=""
				GenerateMapFile="true"
				MapFileName="z:\spu\audio\audio.map"
				ImportLibrary="$(OutDir)/$(TargetName).ppu.obj"
			/>
