SRC = [ Batch $(SRC) : SharedActorsPch.h ] ;

if $(BUILD) = Debug || $(BUILD) = Release
{
	if $(USERNAME) = mbell || $(USERNAME) = mcraig || $(USERNAME) = philliard
	{
		Define SHARED_ACTORS_OPTIMIZE_OFF ;
		echo Optimisations are OFF for shared_actors code ;
	}
}

Library shared_actors : $(SRC) : SharedActorsPch.cpp : SharedActorsPch.h ;
