SRC += $($(PLATFORM)SRC) ;
SRC = source/$(SRC) ;
SRC = [ Batch $(SRC) : SystemPch.h ] ;
SRC += source/debug/BuildStamp.cpp # don't batch this to fix problem with C# apps
source/scheduler/jobqueue_task_queue_lf.cpp
source/automation/Automation.cpp
source/datalogging/DataLogging.cpp ;


if $(PLATFORM) = PS3
{
	AdditionalObjects system : jobqueue_kernel_spu ;
	LINKLIBS += $(SCE_PS3_ROOT)/target/ppu/lib/libfios.a ;
	#required by fios
	LINKLIBS += $(SCE_PS3_ROOT)/target/ppu/lib/libsysutil_np_stub.a ;
}
Library system : $(SRC) : SystemPch.cpp : SystemPch.h ;


if $(PLATFORM) = PS3
{
SPULIBS = atomic dma spurs sync sheap ;
SPULIBS = $(SCE_PS3_ROOT)/target/spu/lib/lib$(SPULIBS).a ;

# Compile the SPU scheduler kernel module and add it into the system library
SRC =
source/scheduler/entry_pm.cpp
source/Perf/ProfilerSPU.cpp
source/scheduler/jobqueue_mem.cpp
source/scheduler/tl_ps3_spu_assert.cpp
source/scheduler/jobqueue_kernel.cpp
source/scheduler/jobqueue_task_queue_lf.cpp
;
SRC = <scheduler_kernel_spu>$(SRC) ;
SrcOptim $(SRC) : "-Os -mbranch-hints -fno-exceptions -x c++ -fno-rtti -DGLOBAL_DEBUG_MESSAGE_LEVEL=0 -DSPURS_JOB -DJOBQUEUE_KERNEL -DTL_PLAT_PS3_SPU -DTL_DISABLE_CONFIG_TESTS -fno-zero-initialized-in-bss" ;
SrcOptim <scheduler_kernel_spu>source/scheduler/jobqueue_task_queue_lf.cpp : "-Os -mbranch-hints -fno-exceptions -x c++ -fno-rtti -DGLOBAL_DEBUG_MESSAGE_LEVEL=0 -DSPURS_JOB -DJOBQUEUE_KERNEL -DTL_PLAT_PS3_SPU -DTL_DISABLE_CONFIG_TESTS -fno-zero-initialized-in-bss" ;

LinkLibraries jobqueue_kernel_spu : $(SPULIBS) ;
SPUApplication jobqueue_kernel_spu : $(SRC) : : : -T$(SUBDIR)/source/scheduler/entry_pm.ld  -nostartfiles -fstack-limit-symbol=__stack_limit -Wl,--defsym,__stack_limit=$(SPU_STACK_LIMIT) ;
	
# Compile the SPU scheduler job module library, which is linked against by scheduler job modules
SRC =
source/Perf/ProfilerSPU.cpp
source/scheduler/jobqueue_mem.cpp
source/scheduler/tl_ps3_spu_assert.cpp
source/scheduler/cache.cpp
;
SRC = <scheduler_joblib_spu>$(SRC) ;
if $(BUILD) = "Debug" || $(BUILD) = "Release"
{
	SrcOptim $(SRC) : -Os ;
}
else
{
	SrcOptim $(SRC) : "-O3 -ffast-math -mvector-simplify -mbranch-hints -fif-conversion --param inline-unit-growth=10000 --param large-function-growth=10000 --param max-inline-insns-single=10000 -fno-exceptions -x c++ -fno-rtti -DSPURS_JOB -DTL_PLAT_PS3_SPU -DTL_DISABLE_CONFIG_TESTS -fno-zero-initialized-in-bss" ;
}

SPULibrary scheduler_joblib_spu : $(SRC) ;

}

SRC =
;

###### Unit test
PS3SRC =
test/scheduler/testscheduler.cpp(SPU)
;
PCSRC =
;

TESTS =
test/scheduler/testscheduler.cpp
;

CxxTest system : $(TESTS) : $($(PLATFORM)SRC) ;
LinkLibraries system : core system ;

SubInclude TOP Code Mercury Library Common Core ;
