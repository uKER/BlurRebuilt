#include "../psCommon.h"
#include "../psConstants.h"

#if !defined(PS_2_0)
float4		g_vPosition[12]	: register(c0);
float4		g_vColour[12]	: register(c12);
float4x4	g_mLight[12]	: register(c24);
float4		g_vDepth		: register(c72);
#else
float4		g_vDepth		: register(c0);
#endif

sampler2D	g_tDepth		: register(s0);
sampler2D	g_tNormal		: register(s1);
sampler3D	g_tLight		: register(s2);

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
	float3	m_Interp	: TEXCOORD1;
	float3	m_Camera	: TEXCOORD2;
};

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

real3 EvaluateLight(float3 vLightPosition, real3 vLightColour, float4x4 mLight, float3 vWorldPosition, real3 vWorldNormal)
{
	real3	vWorldDirection	= normalize(vWorldPosition.xyz - vLightPosition.xyz);
	real	fNDotL			= saturate(dot(vWorldNormal.xyz, -vWorldDirection.xyz) * 0.75f + 0.25f);

	float3	vTexCoord		= mul(float4(vWorldPosition, 1.0f), mLight).xyz;
	real3	vFalloff		= tex3D(g_tLight, vTexCoord).rgb;

	return vLightColour * vFalloff * fNDotL;
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	float3	vWorldPosition	= GetWorldPosition(g_tDepth, input.m_TexCoord, g_vDepth, input.m_Camera, input.m_Interp);
	real3	vWorldNormal	= tex2D(g_tNormal, input.m_TexCoord).rgb * 2.0f - 1.0f;
	
	real3	vDiffuse = 0.0f;

#if defined(ONE)	
	for (int i = 0; i < 1; ++i)
#elif defined(TWO)
	for (int i = 0; i < 2; ++i)
#elif defined(THREE)
	for (int i = 0; i < 3; ++i)
#elif defined(FOUR)
	for (int i = 0; i < 4; ++i)
#elif defined(FIVE)
	for (int i = 0; i < 5; ++i)
#elif defined(SIX)
	for (int i = 0; i < 6; ++i)
#elif defined(SEVEN)
	for (int i = 0; i < 7; ++i)
#elif defined(EIGHT)
	for (int i = 0; i < 8; ++i)
#elif defined(NINE)	
	for (int i = 0; i < 9; ++i)
#elif defined(TEN)
	for (int i = 0; i < 10; ++i)
#elif defined(ELEVEN)
	for (int i = 0; i < 11; ++i)
#elif defined(TWELVE)
	for (int i = 0; i < 12; ++i)
#endif
	{
#if !defined(PS_2_0)
		vDiffuse += EvaluateLight(g_vPosition[i], g_vColour[i], g_mLight[i], vWorldPosition, vWorldNormal);
#endif
	}
		
	output.m_Colour.rgb	= vDiffuse;
	output.m_Colour.a	= 1.0f;

	return output;
}
