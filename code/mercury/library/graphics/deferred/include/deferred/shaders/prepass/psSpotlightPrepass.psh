#include "../psCommon.h"
#include "../psConstants.h"

float4x4	g_mLight		: register(CCP_RENDER_SETTINGS);
float4		g_vXY			: register(CCP_RENDER_SETTINGS_4);
float4		g_vDepth		: register(CCP_RENDER_SETTINGS_5);
float4		g_vOffset		: register(CCP_RENDER_SETTINGS_6);
float4		g_vPosition		: register(CCP_RENDER_SETTINGS_7);
float4		g_vDirection	: register(CCP_RENDER_SETTINGS_8);
float4		g_vColour		: register(CCP_RENDER_SETTINGS_9);
float4		g_vFalloff		: register(CCP_RENDER_SETTINGS_10);

sampler2D	g_tDepth		: register(s0);
sampler2D	g_tNormal		: register(s1);

#if defined(PROJECTED)
sampler2D	g_tProjected	: register(s2);
#elif defined(VOLUME)
sampler3D	g_tVolume		: register(s2);
#endif

struct PS_INPUT
{
#if defined(BLUR_DX11)
	// [Blur2PC] Match vsSpotlightPrepass's position before its screen coordinates.
	float4 m_Position : SV_Position;
#endif
	float4	m_Screen	: TEXCOORD0;
};

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	float2	vUV				= input.m_Screen.xy / input.m_Screen.w;
	
	float3	vViewPosition	= GetViewPosition(g_tDepth, vUV, g_vXY, g_vDepth);
	real3	vViewNormal		= tex2D(g_tNormal, vUV).rgb * 2.0f - 1.0f;
	real3	vViewVector		= vViewPosition.xyz - g_vPosition.xyz;
	float	fViewDistance	= length(vViewVector);
	real3	vViewDirection	= vViewVector / fViewDistance;

	real	fNDotL			= saturate(dot(vViewNormal.xyz, -vViewDirection.xyz) * 0.75f + 0.25f);

#if defined(PROJECTED)
	float3	vLightPosition	= mul(float4(vViewPosition, 1.0f), g_mLight).xyz;
	real3	vFalloff		= tex2D(g_tProjected, vLightPosition.xy / vLightPosition.z).rgb * saturate(1.0f - fViewDistance * fViewDistance * g_vFalloff.x);
#elif defined(VOLUME)
	float3	vLightPosition	= mul(float4(vViewPosition, 1.0f), g_mLight).xyz;
	real3	vFalloff		= tex3D(g_tVolume, vLightPosition).rgb;
#else
	float	fDDotL			= saturate(dot(vViewDirection.xyz, g_vDirection.xyz));
	real	vFalloff		= saturate(1.0f - fViewDistance * fViewDistance * g_vFalloff.x) * saturate((fDDotL - g_vFalloff.y) / (1.0f - g_vFalloff.y));
#endif

	output.m_Colour.rgb		= g_vColour.rgb * (vFalloff * fNDotL);
	output.m_Colour.a		= 1.0f;

	return output;
}
