#include "../../psConstants.h"
#include "../../psCommon.h"

sampler2D	g_tDepthStencil	: register(s0);

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0; 
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

PS_OUTPUT main(PS_INPUT input)
{ 
	PS_OUTPUT output = (PS_OUTPUT) 0;
	
#if defined(XB2)
	float fStencil = tex2D(g_tDepthStencil, input.m_TexCoord).b;
#elif defined(BLUR2PC)
	// [Blur2PC] retail PC (Blur.exe 1.2, bytecode at file offsets 0xc6f62c ps_2_0 / 0xc6f728 ps_3_0) writes |red|
	float fStencil = abs(tex2D(g_tDepthStencil, input.m_TexCoord).r);
#else
	float fStencil = tex2D(g_tDepthStencil, input.m_TexCoord).a;
#endif

	output.m_Colour	= float4(0.0f, 0.0f, 0.0f, fStencil);

	return output;
}
