#include "../psCommon.h"
#include "../psConstants.h"

float4		g_vSettings	:	register(CCP_RENDER_SETTINGS);
float4		g_vScale	:	register(CCP_RENDER_SETTINGS_1);
sampler2D	g_tDepth	:	register(s0);

#define		g_fFocusPlaneDistance	g_vSettings.x
#define		g_fFocusRange			g_vSettings.y

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

float GetDistanceToFocusPlane(float fDepth)
{
	return saturate((abs(fDepth - g_fFocusPlaneDistance) - g_fFocusRange) * 2.0f / g_fFocusRange);
}

float GetFocusDepth(float fDepth)
{
	return saturate((fDepth - g_fFocusPlaneDistance) / (g_fFocusRange * 1.5f));
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;
	
	float	fDepth				= SampleDepthBuffer(g_tDepth, input.m_TexCoord, g_vScale);
	float	fDistanceToPlane	= GetDistanceToFocusPlane(fDepth);
	float	fFocusDepth			= GetFocusDepth(fDepth);
	
	output.m_Colour	= float4(fDistanceToPlane, fDistanceToPlane, fDistanceToPlane, fFocusDepth);
	
	return output;
}
