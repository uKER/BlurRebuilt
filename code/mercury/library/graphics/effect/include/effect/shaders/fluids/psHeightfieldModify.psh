#include "../psCommon.h"
#include "Effect/Shaders/Constants.h"

float4		g_vSettings		: register(CCP_RENDER_SETTINGS);
float4		g_vTransformU	: register(CCP_RENDER_SETTINGS_1);
float4		g_vTransformV	: register(CCP_RENDER_SETTINGS_2);
sampler2D	g_tTexture		: register(s0);
sampler2D	g_tModify		: register(s1);

#define		g_fHeight		g_vSettings.x

struct PS_INPUT
{
	float2	m_TexCoord		: TEXCOORD0;
};

struct PS_OUTPUT
{
	float4	m_Colour		: COLOR0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	float3	vUV				= float3(input.m_TexCoord, 1.0f);
	float2	vModifyUV;
	vModifyUV.x				= dot(vUV, g_vTransformU.xyz);
	vModifyUV.y				= dot(vUV, g_vTransformV.xyz);

	float	fCurrentHeight	= tex2D(g_tTexture, input.m_TexCoord).x;
	float	fModifyHeight	= tex2D(g_tModify, vModifyUV).x * g_fHeight;

	output.m_Colour = float4(fCurrentHeight + fModifyHeight, 0.0f, 0.0f, 1.0f);
	return output;
}
