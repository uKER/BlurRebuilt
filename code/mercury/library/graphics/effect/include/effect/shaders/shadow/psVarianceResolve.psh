#include "../psCommon.h"
#include "Effect/Shaders/Constants.h"

sampler2D	g_tShadowMap	: register(s0);

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	float	fDepth	= SampleDepthBuffer(g_tShadowMap, input.m_TexCoord);	
	output.m_Colour	= float4(fDepth, fDepth * fDepth, 0.0f, 1.0f);

	return output;
}
