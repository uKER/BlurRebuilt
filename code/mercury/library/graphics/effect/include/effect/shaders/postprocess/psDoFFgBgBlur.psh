#include "../psCommon.h"
#include "../psConstants.h"

float4		g_vSettings		: register(CCP_RENDER_SETTINGS);
sampler2D	g_tColour		: register(s0);

#define		g_vPixelSize	g_vSettings.xy

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	real4	vColour	= 0.0f;
			vColour	+= tex2D(g_tColour, input.m_TexCoord + float2(-0.5f, -0.5f) * g_vPixelSize);
			vColour	+= tex2D(g_tColour, input.m_TexCoord + float2(-0.5f, +0.5f) * g_vPixelSize);
			vColour	+= tex2D(g_tColour, input.m_TexCoord + float2(+0.5f, -0.5f) * g_vPixelSize);
			vColour	+= tex2D(g_tColour, input.m_TexCoord + float2(+0.5f, +0.5f) * g_vPixelSize);
			vColour	*= 0.25f;

	output.m_Colour = vColour;

	return output;
}
