    r2.z = (saturate((dot((g_LocalSpaceSHNode[2]).xyzw, (r1).xyzw)).xxxx)).z;
    // mad o4.xyz, r0.w, c135, r2
    o4.xyz = ((r0.wwww * g_VehicleVtxParams[7] + r2)).xyz;
    // mul r1, r0.y, c1
    r1 = ((r0.yyyy * g_mWorld[1])).xyzw;
    // mad r1, r0.x, c0, r1
    r1 = ((r0.xxxx * g_mWorld[0] + r1)).xyzw;
    // mad r0, r0.z, c2, r1
    r0 = ((r0.zzzz * g_mWorld[2] + r1)).xyzw;
    // add r0, r0, c3
    r0 = ((r0 + g_mWorld[3])).xyzw;
    // mul r1, r0.y, c5
    r1 = ((r0.yyyy * g_mViewProj[1])).xyzw;
    // mad r1, r0.x, c4, r1
    r1 = ((r0.xxxx * g_mViewProj[0] + r1)).xyzw;
    // mad r1, r0.z, c6, r1
    r1 = ((r0.zzzz * g_mViewProj[2] + r1)).xyzw;
    // mad r1, r0.w, c7, r1
    r1 = ((r0.wwww * g_mViewProj[3] + r1)).xyzw;
    // mov o3.xyz, r0
    o3.xyz = (r0).xyz;
    // mov o0, r1
    o0 = (r1).xyzw;
    // mov o5, r1
    o5 = (r1).xyzw;
    // mov o1.w, c9.x
    o1.w = (k9.xxxx).w;
    // mov o2, v2
    o2 = (v2).xyzw;
    // mul o4.w, c8.x, v6.x
    o4.w = ((k8.xxxx * v6.xxxx)).w;
    RecoveredVertexOutput output = (RecoveredVertexOutput)0;
    output.position = o0;
    output.uv0 = o1;
    output.uv1 = o2;
    output.uv2 = o3;
    output.uv4 = o4;
    output.uv5 = o5;
    return output;
}

struct RecoveredMaterialPrepassNoDamageVSInput {
    float4 v0 : POSITION;
    float4 v1 : NORMAL;
    float4 v2 : TEXCOORD;
    float4 v3 : TEXCOORD2;
    float4 v4 : TEXCOORD3;
    uint4 v5 : TEXCOORD4;
    float4 v6 : COLOR;
};
RecoveredVertexOutput RecoveredMaterialPrepassNoDamageVS(RecoveredMaterialPrepassNoDamageVSInput input) {
    float4 v0 = input.v0;
    float4 v1 = input.v1;
    float4 v2 = input.v2;
    float4 v3 = input.v3;
    float4 v4 = input.v4;
    float4 v5 = input.v5;
    float4 v6 = input.v6;
    float4 o0 = 0;
    float4 o1 = 0;
    float4 o2 = 0;
    float4 o3 = 0;
    float4 o4 = 0;
    float4 o5 = 0;
    float4 r0 = 0;
    float4 r1 = 0;
    float4 r2 = 0;
    int4 a0 = 0;
    const float4 k8 = float4(1, 2, 0, -1);
    const float4 k9 = float4(2, -1, 0.00393700786, -0.400000006);
    const float4 k10 = float4(1.66666663, 0.5, 0, 0);
    // mad r0.xyz, v1, c9.x, c9.y
    r0.xyz = ((v1 * k9.xxxx + k9.yyyy)).xyz;
    // mad r1.xyz, v4, c9.x, c9.y
    r1.xyz = ((v4 * k9.xxxx + k9.yyyy)).xyz;
    // mad r0.xyz, r1, c203.w, r0
    r0.xyz = ((r1 * g_vUndercoatColour[0].wwww + r0)).xyz;
    // nrm r1.xyz, r0
    r1.xyz = (float4(normalize((r0).xyz), 0)).xyz;
    // mul r0.xyz, r1.y, c1
    r0.xyz = ((r1.yyyy * g_mWorld[1])).xyz;
    // mad r0.xyz, r1.x, c0, r0
    r0.xyz = ((r1.xxxx * g_mWorld[0] + r0)).xyz;
    // mad o1.xyz, r1.z, c2, r0
    o1.xyz = ((r1.zzzz * g_mWorld[2] + r0)).xyz;
    // mov_sat r0.x, -r1.z
    r0.x = (saturate((-r1.zzzz))).x;
    // add r0.x, r0.x, c9.w
    r0.x = ((r0.xxxx + k9.wwww)).x;
    // max r0.x, r0.x, c8.z
    r0.x = (max(r0.xxxx, k8.zzzz)).x;
    // mul r0.x, r0.x, c10.x
    r0.x = ((r0.xxxx * k10.xxxx)).x;
    // mul r0.x, r0.x, r0.x
    r0.x = ((r0.xxxx * r0.xxxx)).x;
    // mul r0.y, c10.y, v0.z
    r0.y = ((k10.yyyy * v0.zzzz)).y;
    // mov_sat r0.y, -r0.y
    r0.y = (saturate((-r0.yyyy))).y;
    // mul r0.x, r0.y, r0.x
    r0.x = ((r0.yyyy * r0.xxxx)).x;
    // add r0.y, v6.x, v6.x
    r0.y = ((v6.xxxx + v6.xxxx)).y;
    // mul r0.x, r0.y, r0.x
    r0.x = ((r0.yyyy * r0.xxxx)).x;
    // mad r1, v6, c8.xyyy, c8.zwww
    r1 = ((v6 * k8.xyyy + k8.zwww)).xyzw;
    // dp4_sat r2.x, c136, r1
    r2.x = (saturate((dot((g_LocalSpaceSHNode[0]).xyzw, (r1).xyzw)).xxxx)).x;
    // dp4_sat r2.y, c137, r1
    r2.y = (saturate((dot((g_LocalSpaceSHNode[1]).xyzw, (r1).xyzw)).xxxx)).y;
    // dp4_sat r2.z, c138, r1
    r2.z = (saturate((dot((g_LocalSpaceSHNode[2]).xyzw, (r1).xyzw)).xxxx)).z;
    // mad o4.xyz, r0.x, c135, r2
    o4.xyz = ((r0.xxxx * g_VehicleVtxParams[7] + r2)).xyz;
    // frc r0.xy, v5
    r0.xy = (frac(v5)).xy;
    // add r0.xy, -r0, v5
    r0.xy = (((-r0) + v5)).xy;
    // mova a0.xy, r0
    a0.xy = (int4(round(r0))).xy;
    // mov r0.xyz, c144[a0.x]
    r0.xyz = (g_vControlPoints[0 + a0.x]).xyz;
    // add r0.xyz, -r0, c144[a0.y]
    r0.xyz = (((-r0) + g_vControlPoints[0 + a0.y])).xyz;
    // mul r0.w, c9.z, v5.z
    r0.w = ((k9.zzzz * v5.zzzz)).w;
    // mad r0.xyz, r0.w, r0, c144[a0.x]
    r0.xyz = ((r0.wwww * r0 + g_vControlPoints[0 + a0.x])).xyz;
    // add r0.xyz, r0, v0
    r0.xyz = ((r0 + v0)).xyz;
    // mad r1.xyz, v3, c9.x, c9.y
    r1.xyz = ((v3 * k9.xxxx + k9.yyyy)).xyz;
    // mad r0.xyz, r1, c203.w, r0
    r0.xyz = ((r1 * g_vUndercoatColour[0].wwww + r0)).xyz;
    // mul r1, r0.y, c1
    r1 = ((r0.yyyy * g_mWorld[1])).xyzw;
    // mad r1, r0.x, c0, r1
    r1 = ((r0.xxxx * g_mWorld[0] + r1)).xyzw;
    // mad r0, r0.z, c2, r1
    r0 = ((r0.zzzz * g_mWorld[2] + r1)).xyzw;
    // add r0, r0, c3
    r0 = ((r0 + g_mWorld[3])).xyzw;
    // mul r1, r0.y, c5
    r1 = ((r0.yyyy * g_mViewProj[1])).xyzw;
    // mad r1, r0.x, c4, r1
    r1 = ((r0.xxxx * g_mViewProj[0] + r1)).xyzw;
    // mad r1, r0.z, c6, r1
    r1 = ((r0.zzzz * g_mViewProj[2] + r1)).xyzw;
    // mad r1, r0.w, c7, r1
    r1 = ((r0.wwww * g_mViewProj[3] + r1)).xyzw;
    // mov o3.xyz, r0
    o3.xyz = (r0).xyz;
    // mov o0, r1
    o0 = (r1).xyzw;
    // mov o5, r1
    o5 = (r1).xyzw;
    // mov o1.w, c8.z
    o1.w = (k8.zzzz).w;
    // mov o2, v2
    o2 = (v2).xyzw;
    // mov r0.x, c9.x
    r0.x = (k9.xxxx).x;
    // mul o3.w, r0.x, c204.w
    o3.w = ((r0.xxxx * g_vScuffColour[0].wwww)).w;
    // mul o4.w, c9.x, v6.x
    o4.w = ((k9.xxxx * v6.xxxx)).w;
    RecoveredVertexOutput output = (RecoveredVertexOutput)0;
    output.position = o0;
    output.uv0 = o1;
    output.uv1 = o2;
    output.uv2 = o3;
    output.uv4 = o4;
    output.uv5 = o5;
    return output;
}

