    float4 o3 = 0;
    float4 o4 = 0;
    float4 o5 = 0;
    float4 r0 = 0;
    float4 r1 = 0;
    float4 r2 = 0;
    const float4 k8 = float4(2, -1, 1, 0);
    const float4 k9 = float4(-0.400000006, 1.66666663, 0.5, 0);
