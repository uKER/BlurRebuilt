    r0.w = ((dot((r0).xyz, (r0).xyz)).xxxx).w;
    // rsq r0.w, r0.w
    r0.w = ((rsqrt(abs((r0.wwww).x))).xxxx).w;
    // mul r0.xyz, r0.w, r0
    r0.xyz = ((r0.wwww * r0)).xyz;
