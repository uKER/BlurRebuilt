    float4 oC0 = 0;
    float4 r0 = 0;
    const float4 k0 = float4(255, 0.5, 0.00392156886, 0);
    // rcp r0.x, v1.w
    r0.x = ((1.0 / (v1.wwww).x).xxxx).x;
    // mul r0.x, r0.x, v1.z
    r0.x = ((r0.xxxx * v1.zzzz)).x;
    // mov oC1, -r0.x
    oC1 = ((-r0.xxxx)).xyzw;
    // dp3 r0.x, v0, v0
    r0.x = ((dot((v0).xyz, (v0).xyz)).xxxx).x;
    // rsq r0.x, r0.x
    r0.x = ((rsqrt(abs((r0.xxxx).x))).xxxx).x;
    // mul r0.xy, r0.x, v0
    r0.xy = ((r0.xxxx * v0)).xy;
    // mad oC0.xy, r0, c0.y, c0.y
    oC0.xy = ((r0 * k0.yyyy + k0.yyyy)).xy;
