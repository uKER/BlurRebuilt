    // mov o1.w, c8.w
    o1.w = (k8.wwww).w;
    // mov o2.w, c8.w
    o2.w = (k8.wwww).w;
    // mul o3.w, c8.x, v2.x
    o3.w = ((k8.xxxx * v2.xxxx)).w;
