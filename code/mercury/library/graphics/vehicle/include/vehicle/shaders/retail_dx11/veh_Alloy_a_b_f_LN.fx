    r0.w = ((r0.wwww * k1.xxxx)).w;
    // exp_sat r0.w, r0.w
    r0.w = (saturate((exp2((r0.wwww).x)).xxxx)).w;
    // nrm r1.xyz, v0
    r1.xyz = (float4(normalize((v0).xyz), 0)).xyz;
    // dp3 r1.w, r1, r0
    r1.w = ((dot((r1).xyz, (r0).xyz)).xxxx).w;
    // add r2.x, r1.w, r1.w
    r2.x = ((r1.wwww + r1.wwww)).x;
