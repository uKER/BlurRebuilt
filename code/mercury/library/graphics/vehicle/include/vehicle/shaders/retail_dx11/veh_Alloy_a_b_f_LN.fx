    // mov oC0.w, r0.y
    oC0.w = (r0.yyyy).w;
    // mul oC0.z, r0.x, c0.z
    oC0.z = ((r0.xxxx * k0.zzzz)).z;
    RecoveredMaterialPrepassPSOutput output = (RecoveredMaterialPrepassPSOutput)0;
    output.oC1 = oC1;
    output.oC0 = oC0;
    return output;
}

struct RecoveredMaterialPrepassVSInput {
    float4 v0 : POSITION;
    float4 v1 : NORMAL;
    float4 v2 : COLOR;
};
RecoveredVertexOutput RecoveredMaterialPrepassVS(RecoveredMaterialPrepassVSInput input) {
    float4 v0 = input.v0;
    float4 v1 = input.v1;
    float4 v2 = input.v2;
    float4 o0 = 0;
    float4 o1 = 0;
    float4 o2 = 0;
    float4 o3 = 0;
    float4 o4 = 0;
    float4 r0 = 0;
    float4 r1 = 0;
    const float4 k8 = float4(2, -1, 1, 0);
    // mad r0.xyz, v1, c8.x, c8.y
    r0.xyz = ((v1 * k8.xxxx + k8.yyyy)).xyz;
    // mul r1.xyz, r0.y, c1
    r1.xyz = ((r0.yyyy * g_mWorld[1])).xyz;
    // mad r0.xyw, r0.x, c0.xyzz, r1.xyzz
    r0.xyw = ((r0.xxxx * g_mWorld[0].xyzz + r1.xyzz)).xyw;
    // mad r0.xyz, r0.z, c2, r0.xyww
    r0.xyz = ((r0.zzzz * g_mWorld[2] + r0.xyww)).xyz;
    // dp3 r0.w, r0, r0
    r0.w = ((dot((r0).xyz, (r0).xyz)).xxxx).w;
    // rsq r0.w, r0.w
    r0.w = ((rsqrt(abs((r0.wwww).x))).xxxx).w;
    // mul o1.xyz, r0.w, r0
    o1.xyz = ((r0.wwww * r0)).xyz;
    // mad r0, v2, c8.zxxx, c8.wyyy
    r0 = ((v2 * k8.zxxx + k8.wyyy)).xyzw;
    // dp4_sat o3.x, c136, r0
    o3.x = (saturate((dot((g_LocalSpaceSHNode[0]).xyzw, (r0).xyzw)).xxxx)).x;
    // dp4_sat o3.y, c137, r0
    o3.y = (saturate((dot((g_LocalSpaceSHNode[1]).xyzw, (r0).xyzw)).xxxx)).y;
    // dp4_sat o3.z, c138, r0
    o3.z = (saturate((dot((g_LocalSpaceSHNode[2]).xyzw, (r0).xyzw)).xxxx)).z;
    // mul r0, c1, v0.y
    r0 = ((g_mWorld[1] * v0.yyyy)).xyzw;
    // mad r0, v0.x, c0, r0
    r0 = ((v0.xxxx * g_mWorld[0] + r0)).xyzw;
    // mad r0, v0.z, c2, r0
    r0 = ((v0.zzzz * g_mWorld[2] + r0)).xyzw;
    // add r0, r0, c3
    r0 = ((r0 + g_mWorld[3])).xyzw;
    // mul r1, r0.y, c5
    r1 = ((r0.yyyy * g_mViewProj[1])).xyzw;
    // mad r1, r0.x, c4, r1
    r1 = ((r0.xxxx * g_mViewProj[0] + r1)).xyzw;
    // mad r1, r0.z, c6, r1
    r1 = ((r0.zzzz * g_mViewProj[2] + r1)).xyzw;
    // mad r1, r0.w, c7, r1
    r1 = ((r0.wwww * g_mViewProj[3] + r1)).xyzw;
