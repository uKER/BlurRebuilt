    r0 = ((r0.zzzz * g_mWorld[2] + r1)).xyzw;
    // add r0, r0, c3
    r0 = ((r0 + g_mWorld[3])).xyzw;
    // mul r1, r0.y, c5
    r1 = ((r0.yyyy * g_mViewProj[1])).xyzw;
    // mad r1, r0.x, c4, r1
    r1 = ((r0.xxxx * g_mViewProj[0] + r1)).xyzw;
    // mad r1, r0.z, c6, r1
    r1 = ((r0.zzzz * g_mViewProj[2] + r1)).xyzw;
    // mad r1, r0.w, c7, r1
    r1 = ((r0.wwww * g_mViewProj[3] + r1)).xyzw;
    // mov o3.xyz, r0
    o3.xyz = (r0).xyz;
    // mov o0, r1
    o0 = (r1).xyzw;
    // mov o5, r1
    o5 = (r1).xyzw;
    // mov o1.w, c10.z
    o1.w = (k10.zzzz).w;
    // mov o2, v2
    o2 = (v2).xyzw;
    // mov o3.w, c10.z
    o3.w = (k10.zzzz).w;
    // mul o4.w, c8.x, v6.x
    o4.w = ((k8.xxxx * v6.xxxx)).w;
    RecoveredVertexOutput output = (RecoveredVertexOutput)0;
    output.position = o0;
    output.uv0 = o1;
    output.uv1 = o2;
    output.uv2 = o3;
    output.uv4 = o4;
    output.uv5 = o5;
    return output;
}

