#include "..\..\psCommon.h"

sampler2D	g_tLuminance			: register(s0);

struct PS_INPUT
{
	float2 uv				: TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 colour					: COLOR0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT)0;
	output.colour = tex2D(g_tLuminance, input.uv);
	return output;
}
