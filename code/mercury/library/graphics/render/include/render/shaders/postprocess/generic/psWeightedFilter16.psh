#include "..\..\psCommon.h"

sampler2D textureMap : register(s0);

float4 g_vTaps[16] : register(CCP_RENDER_POSTPROCESS_PARAMETERS_0);

#if defined(PLATFORM_PS3)
#pragma texformat textureMap RGBA8
#endif

struct PS_OUTPUT
{
	float4 colour     : COLOR0; 
};

struct VS_OUTPUT
{
	#if defined(BLUR_DX11) // [Blur1PCDX11] D3D11 links stages by register; the full-screen vertex shader emits SV_Position last.

    float2 uv		: TEXCOORD0;
    float4 position	: SV_Position;
	#else
    float4 position	: POSITION;		//Pixel position (world-view-proj space)  
    float2 uv		: TEXCOORD0;
	#endif
};

PS_OUTPUT main(VS_OUTPUT input)
{ 
    PS_OUTPUT output = (PS_OUTPUT)0;
   
	real3 sample = 0.0h;
	
	for(int i = 0; i < 16; ++i)
	{
		#ifdef GAMMA
			real3 map = tex2D(textureMap, input.uv + g_vTaps[i].xy).rgb;
			sample += g_vTaps[i].w * (map * map);
		#else
			sample += g_vTaps[i].w * tex2D(textureMap, input.uv + g_vTaps[i].xy).rgb;
		#endif
	}
	
#ifndef PS_2_0 // [LloydW] Too many instructions for ps_2_0...
	#ifdef GAMMA
		output.colour = float4(sqrt(sample), 1.0h);
	#else
		output.colour = float4(sample, 1.0h);
	#endif
#endif
	
	return output;
}
