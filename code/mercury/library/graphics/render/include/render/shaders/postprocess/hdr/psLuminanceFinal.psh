#include "..\..\psCommon.h"

sampler2D	luminanceMap		: register(s0);

float2		g_vTaps[16]		: register(CCP_RENDER_POSTPROCESS_PARAMETERS_0);
float4		g_vLuminanceClamp : register(CCP_RENDER_POSTPROCESS_PARAMETERS_16);

#define g_fLumMin				g_vLuminanceClamp.x
#define g_fLumMax				g_vLuminanceClamp.y
#define g_fLuminanceAdjustment	g_vLuminanceClamp.z

struct PS_INPUT
{
	float2 uv			: TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 colour		: COLOR0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT)0;

	float2 fSum = 0.0f;
	for(int i = 0; i < 16; i++)
	{
		fSum += tex2D(luminanceMap, input.uv + g_vTaps[i]).rg;
	}
	
	float fLum = exp(fSum.x / fSum.y) + g_fLuminanceAdjustment;
	
	if(fLum < g_fLumMin)
		fLum = g_fLumMin;
	if(fLum > g_fLumMax)
		fLum = g_fLumMax;

	output.colour = float4(fLum, 0.f, 0.f, 1.f);
	
	return output;
}
