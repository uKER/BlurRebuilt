#include "../psCommon.h"
#include "../psConstants.h"

#if defined(TAPS_5)
#	define TAPS 5
#elif defined(TAPS_7)
#	define TAPS 7
#elif defined(TAPS_9)
#	define TAPS 9
#elif defined(TAPS_11)
#	define TAPS 11
#elif defined(TAPS_13)
#	define TAPS 13
#endif

float4		g_vSettings		: register(CCP_RENDER_SETTINGS);
float4		g_vWeights0		: register(CCP_RENDER_SETTINGS_1);
float4		g_vWeights1		: register(CCP_RENDER_SETTINGS_2);
sampler2D	g_tColour		: register(s0);

#define		g_vOffset		g_vSettings.xy

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	real4	vColour		= g_vWeights0.x * tex2D(g_tColour, input.m_TexCoord);
#if TAPS > 1
			vColour		+= g_vWeights0.y * (tex2D(g_tColour, input.m_TexCoord + g_vOffset) + tex2D(g_tColour, input.m_TexCoord - g_vOffset));
#if TAPS > 3
			vColour		+= g_vWeights0.z * (tex2D(g_tColour, input.m_TexCoord + 2.0f * g_vOffset) + tex2D(g_tColour, input.m_TexCoord - 2.0f * g_vOffset));
#if TAPS > 5
			vColour		+= g_vWeights0.w * (tex2D(g_tColour, input.m_TexCoord + 3.0f * g_vOffset) + tex2D(g_tColour, input.m_TexCoord - 3.0f * g_vOffset));
#if TAPS > 7
			vColour		+= g_vWeights1.x * (tex2D(g_tColour, input.m_TexCoord + 4.0f * g_vOffset) + tex2D(g_tColour, input.m_TexCoord - 4.0f * g_vOffset));
#if TAPS > 9
			vColour		+= g_vWeights1.y * (tex2D(g_tColour, input.m_TexCoord + 5.0f * g_vOffset) + tex2D(g_tColour, input.m_TexCoord - 5.0f * g_vOffset));
#if TAPS > 11
			vColour		+= g_vWeights1.z * (tex2D(g_tColour, input.m_TexCoord + 6.0f * g_vOffset) + tex2D(g_tColour, input.m_TexCoord - 6.0f * g_vOffset));
#endif
#endif
#endif
#endif
#endif
#endif

	output.m_Colour = vColour;

	return output;
}
