float4 GaussianBlurY_13Taps(float2 vUV)
{
#if defined(YB2)
	float4	vSample0, vSample1, vSample2, vSample3;
	float4	vSample4, vSample5, vSample6, vSample7;
	float4	vSample8, vSample9, vSample10, vSample11;
	float4	vSample12;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -6.0, MinFilter=point, MagFilter=point
		tfetch2D vSample1, vUV, g_tColour, OffsetY = -5.0, MinFilter=point, MagFilter=point
		tfetch2D vSample2, vUV, g_tColour, OffsetY = -4.0, MinFilter=point, MagFilter=point
		tfetch2D vSample3, vUV, g_tColour, OffsetY = -3.0, MinFilter=point, MagFilter=point
