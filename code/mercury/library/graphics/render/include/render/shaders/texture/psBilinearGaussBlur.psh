}

real4 GaussianBlurY_11Taps(float2 vUV)
{
#if defined(YB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	real4	vSample8, vSample9;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetY = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetY = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetY = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetY = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample6, vUV, g_tColour, OffsetY = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample7, vUV, g_tColour, OffsetY = +2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample8, vUV, g_tColour, OffsetY = +3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample9, vUV, g_tColour, OffsetY = +4.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -4.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -3.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample8	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
	real4	vSample9	= tex2D(g_tColour, vUV + +4.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample9) + g_vWeights0.y * (vSample1 + vSample8) + g_vWeights0.z * (vSample2 + vSample7) + g_vWeights0.w * (vSample3 + vSample6) + g_vWeights1.x * (vSample4 + vSample5);
}

real4 GaussianBlurY_13Taps(float2 vUV)
{
#if defined(YB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	real4	vSample8, vSample9, vSample10, vSample11;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -5.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetY = -4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetY = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetY = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetY = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetY = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample6, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample7, vUV, g_tColour, OffsetY = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample8, vUV, g_tColour, OffsetY = +2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample9, vUV, g_tColour, OffsetY = +3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample10, vUV, g_tColour, OffsetY = +4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample11, vUV, g_tColour, OffsetY = +5.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -5.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -4.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -3.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample8	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample9	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
	real4	vSample10	= tex2D(g_tColour, vUV + +4.5f * g_vOffset);
	real4	vSample11	= tex2D(g_tColour, vUV + +5.5f * g_vOffset);	
#endif
	return g_vWeights0.x * (vSample0 + vSample11) + g_vWeights0.y * (vSample1 + vSample10) + g_vWeights0.z * (vSample2 + vSample9) + g_vWeights0.w * (vSample3 + vSample8) + g_vWeights1.x * (vSample4 + vSample7) + g_vWeights1.y * (vSample5 + vSample6);
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

#if defined(HORIZONTAL)
	#if defined(TAPS_5)
		output.m_Colour = GaussianBlurX_5Taps(input.m_TexCoord);
	#elif defined(TAPS_7)
		output.m_Colour = GaussianBlurX_7Taps(input.m_TexCoord);
	#elif defined(TAPS_9)
		output.m_Colour = GaussianBlurX_9Taps(input.m_TexCoord);
	#elif defined(TAPS_11)
		output.m_Colour = GaussianBlurX_11Taps(input.m_TexCoord);
	#elif defined(TAPS_13)
		output.m_Colour = GaussianBlurX_13Taps(input.m_TexCoord);
	#endif
#elif defined(VERTICAL)
	#if defined(TAPS_5)
		output.m_Colour = GaussianBlurY_5Taps(input.m_TexCoord);
	#elif defined(TAPS_7)
		output.m_Colour = GaussianBlurY_7Taps(input.m_TexCoord);
	#elif defined(TAPS_9)
		output.m_Colour = GaussianBlurY_9Taps(input.m_TexCoord);
	#elif defined(TAPS_11)
		output.m_Colour = GaussianBlurY_11Taps(input.m_TexCoord);
	#elif defined(TAPS_13)
		output.m_Colour = GaussianBlurY_13Taps(input.m_TexCoord);
	#endif
#endif

	return output;
}
