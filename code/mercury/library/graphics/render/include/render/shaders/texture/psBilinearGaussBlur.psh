		tfetch2D vSample2, vUV, g_tColour, OffsetY = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetY = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetY = +2.5, MinFilter=linear, MagFilter=linear
	};
