{
#if defined(YB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetY = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetY = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetY = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
