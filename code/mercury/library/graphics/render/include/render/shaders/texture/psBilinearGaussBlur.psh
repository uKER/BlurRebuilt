	real4	vSample2	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
