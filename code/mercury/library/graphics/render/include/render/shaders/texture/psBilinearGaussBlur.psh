{
#if defined(YB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -2.5, MinFilter=linear, MagFilter=linear
