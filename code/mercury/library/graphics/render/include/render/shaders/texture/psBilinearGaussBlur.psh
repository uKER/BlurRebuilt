#include "../psCommon.h"
#include "../psConstants.h"

#if defined(TAPS_5)
#	define TAPS 5
#elif defined(TAPS_7)
#	define TAPS 7
#elif defined(TAPS_9)
#	define TAPS 9
#elif defined(TAPS_11)
#	define TAPS 11
#elif defined(TAPS_13)
#	define TAPS 13
#endif

float4		g_vSettings		: register(CCP_RENDER_SETTINGS);
float4		g_vWeights0		: register(CCP_RENDER_SETTINGS_1);
float4		g_vWeights1		: register(CCP_RENDER_SETTINGS_2);
sampler2D	g_tColour		: register(s0);

#define		g_vOffset		g_vSettings.xy

struct PS_OUTPUT
{
	float4	m_Colour	: COLOR0;
};

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
};

real4 GaussianBlurX_5Taps(float2 vUV)
{
#if defined(XB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetX = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetX = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample3) + g_vWeights0.y * (vSample1 + vSample2);
}

real4 GaussianBlurX_7Taps(float2 vUV)
{
#if defined(XB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetX = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetX = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetX = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetX = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetX = +2.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample5) + g_vWeights0.y * (vSample1 + vSample4) + g_vWeights0.z * (vSample2 + vSample3);
}

real4 GaussianBlurX_9Taps(float2 vUV)
{
#if defined(XB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetX = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetX = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetX = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetX = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetX = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample6, vUV, g_tColour, OffsetX = +2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample7, vUV, g_tColour, OffsetX = +3.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -3.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample7) + g_vWeights0.y * (vSample1 + vSample6) + g_vWeights0.z * (vSample2 + vSample5) + g_vWeights0.w * (vSample3 + vSample4);
}

real4 GaussianBlurX_11Taps(float2 vUV)
{
#if defined(XB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	real4	vSample8, vSample9;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetX = -4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetX = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetX = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetX = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetX = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample6, vUV, g_tColour, OffsetX = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample7, vUV, g_tColour, OffsetX = +2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample8, vUV, g_tColour, OffsetX = +3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample9, vUV, g_tColour, OffsetX = +4.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -4.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -3.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample8	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
	real4	vSample9	= tex2D(g_tColour, vUV + +4.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample9) + g_vWeights0.y * (vSample1 + vSample8) + g_vWeights0.z * (vSample2 + vSample7) + g_vWeights0.w * (vSample3 + vSample6) + g_vWeights1.x * (vSample4 + vSample5);
}

real4 GaussianBlurX_13Taps(float2 vUV)
{
#if defined(XB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	real4	vSample4, vSample5, vSample6, vSample7;
	real4	vSample8, vSample9, vSample10, vSample11;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetX = -5.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetX = -4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetX = -3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetX = -2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample4, vUV, g_tColour, OffsetX = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample5, vUV, g_tColour, OffsetX = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample6, vUV, g_tColour, OffsetX = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample7, vUV, g_tColour, OffsetX = +1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample8, vUV, g_tColour, OffsetX = +2.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample9, vUV, g_tColour, OffsetX = +3.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample10, vUV, g_tColour, OffsetX = +4.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample11, vUV, g_tColour, OffsetX = +5.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -5.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -4.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + -3.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + -2.5f * g_vOffset);
	real4	vSample4	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample5	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample6	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample7	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
	real4	vSample8	= tex2D(g_tColour, vUV + +2.5f * g_vOffset);
	real4	vSample9	= tex2D(g_tColour, vUV + +3.5f * g_vOffset);
	real4	vSample10	= tex2D(g_tColour, vUV + +4.5f * g_vOffset);
	real4	vSample11	= tex2D(g_tColour, vUV + +5.5f * g_vOffset);	
#endif
	return g_vWeights0.x * (vSample0 + vSample11) + g_vWeights0.y * (vSample1 + vSample10) + g_vWeights0.z * (vSample2 + vSample9) + g_vWeights0.w * (vSample3 + vSample8) + g_vWeights1.x * (vSample4 + vSample7) + g_vWeights1.y * (vSample5 + vSample6);
}

real4 GaussianBlurY_5Taps(float2 vUV)
{
#if defined(YB2)
	real4	vSample0, vSample1, vSample2, vSample3;
	asm
	{
		tfetch2D vSample0, vUV, g_tColour, OffsetY = -1.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample1, vUV, g_tColour, OffsetY = -0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample2, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
		tfetch2D vSample3, vUV, g_tColour, OffsetY = +0.5, MinFilter=linear, MagFilter=linear
	};
#else
	real4	vSample0	= tex2D(g_tColour, vUV + -1.5f * g_vOffset);
	real4	vSample1	= tex2D(g_tColour, vUV + -0.5f * g_vOffset);
	real4	vSample2	= tex2D(g_tColour, vUV + +0.5f * g_vOffset);
	real4	vSample3	= tex2D(g_tColour, vUV + +1.5f * g_vOffset);
#endif
	return g_vWeights0.x * (vSample0 + vSample3) + g_vWeights0.y * (vSample1 + vSample2);
}

