#include "../../../../../deferred/include/deferred/shaders/psCommon.h" //Getting deferred version
#include "../psConstants.h"
#include "../psHDR.h"

float4		g_vPosition[8]	: register(CCP_RENDER_SETTINGS);
float4		g_vIntensity[8]	: register(CCP_RENDER_SETTINGS_8);
float4		g_vDepth		: register(CCP_RENDER_SETTINGS_20);
float4		g_vViewUpVector	: register(CCP_RENDER_SETTINGS_21);

sampler2D	g_tDepth		: register(s0);
sampler2D	g_tNormal		: register(s1);

struct PS_INPUT
{
	float2	m_TexCoord	: TEXCOORD0;
	float3	m_Scale		: TEXCOORD1;
};
PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output = (PS_OUTPUT) 0;

	float3	vViewPosition	= GetViewPosition(g_tDepth, input.m_TexCoord, g_vDepth.x, input.m_Scale);
	float3	vViewNormal	= normalize(tex2D(g_tNormal, input.m_TexCoord).rgb - 0.5f);
	
	float	fShadow = 1.0f;
#if defined(ONE)	
	int i = 0;
#elif defined(TWO)
	for (int i = 0; i < 2; ++i)
#elif defined(THREE)
	for (int i = 0; i < 3; ++i)
#elif defined(FOUR)
	for (int i = 0; i < 4; ++i)
#elif defined(FIVE)
	for (int i = 0; i < 5; ++i)
#elif defined(SIX)
	for (int i = 0; i < 6; ++i)
#elif defined(SEVEN)
	for (int i = 0; i < 7; ++i)
#elif defined(EIGHT)
	for (int i = 0; i < 8; ++i)
#endif
	{
#if !defined(PS_2_0)
		float3	vShadowCaster		= g_vPosition[i].xyz;
		float	fShadowFalloff		= g_vPosition[i].w;
		float	fShadowIntensity	= g_vIntensity[i].x;
		
		float3	vShadowVector		= vShadowCaster - vViewPosition;
		float	fShadowDistance		= dot(vShadowVector, vShadowVector);
		float	fShadowFactor		= saturate(fShadowDistance * fShadowFalloff);
		float	fShadowDotNormal	= saturate(dot(normalize(vShadowVector), vViewNormal));
				fShadowDotNormal	= pow(fShadowDotNormal, 1.0f / 16.0f);
		float	fShadowScale		= lerp(1.0f, fShadowFactor, fShadowDotNormal * saturate(dot(vShadowVector.xyz,g_vViewUpVector.xyz) * fShadowFalloff * 4.f));
	
		fShadow *= lerp(saturate(1.0f - fShadowIntensity), 1.0f, fShadowScale);
#endif
	}

#if defined(HDR)
	fShadow = sqrt(fShadow);
#endif

	output.colour = float4(fShadow, fShadow, fShadow, 1.0f);

	return output;;
}
