#include "..\psCommon.h"
#include "psUiLightCommon.h"

sampler2D	g_Texture0			: register(s0);
sampler2D	g_Texture1			: register(s1);
sampler2D	g_Texture2			: register(s2);

struct PS_INPUT
{
	float4 Colour				: COLOR0;
	float4 MyWorldPosition		: TEXCOORD3;
	float2 TexCoord0			: TEXCOORD0;
#if defined( SAMPLERS_2 ) || defined( SAMPLERS_3 )
	float2 TexCoord1			: TEXCOORD1;
#endif
#if defined( SAMPLERS_3 )
	float2 TexCoord2			: TEXCOORD2;
#endif
};

struct PS_OUTPUT
{
	float4 Colour				: COLOR;
};

PS_OUTPUT main(PS_INPUT IN)
{
	PS_OUTPUT OUT = (PS_OUTPUT)0;
	
	OUT.Colour = IN.Colour;
	
	float4 tex0 = tex2D( g_Texture0, IN.TexCoord0 );
	
	OUT.Colour *= tex0;
	
#if defined( SAMPLERS_2 ) || defined( SAMPLERS_3 )
	OUT.Colour *= tex2D( g_Texture1, IN.TexCoord1 );
#endif // SAMPLERS_2

#if defined( SAMPLERS_3 )
	{
		float4 tex2 = tex2D( g_Texture2, IN.TexCoord2 );
		
		float intensity = (tex0[0]+tex0[1]+tex0[2]) / 3;
		float4 intensity_mul = {intensity,intensity,intensity,0};
		
		tex2 *= intensity_mul;

		OUT.Colour = saturate( OUT.Colour + tex2 );
	}
#endif // SAMPLERS_3
	
	OUT.Colour = CombineFog( OUT.Colour, LightColour( IN.MyWorldPosition ) );
	
	return OUT;
}
