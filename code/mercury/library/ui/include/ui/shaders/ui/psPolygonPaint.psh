/*---------------------------------------------------------------------------------------
	File	: psPolygonPaint.vsh

	Desc	: 
---------------------------------------------------------------------------------------*/

#include "..\psCommon.h"

sampler2D	g_Texture0			: register(s0);

struct PS_INPUT
{
	#if defined(BLUR_DX11) // [Blur1PCDX11] SM5 requires a float4 system position.
	float4 Position				: SV_Position;
	#else
	float3 Position				: POSITION;
	#endif
	float4 Colour				: COLOR;
	float2 TexCoord0			: TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 Colour				: COLOR;
};

PS_OUTPUT main( PS_INPUT IN )
{
	PS_OUTPUT OUT = (PS_OUTPUT)0;
	
	float4 t0 = tex2D( g_Texture0, IN.TexCoord0 );

	t0.a = t0.g;
	OUT.Colour = (IN.Colour * t0);

	return OUT;
}
