#include "..\psCommon.h"

float4		g_Settings			: register( CCP_SETTINGS );

sampler2D	g_Texture0			: register(s0);				// texture
sampler2D	g_Texture1			: register(s1);

#define		g_fCutoutValue		g_Settings.x

struct PS_INPUT
{
	float4 Colour				: COLOR;
	float2 TexCoord0			: TEXCOORD0;
	float2 TexCoord1			: TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 Colour				: COLOR;
};

// --------------------------------------
// TODO - move amax shaders into own file
// --------------------------------------

PS_OUTPUT main(PS_INPUT IN)
{
	PS_OUTPUT OUT = (PS_OUTPUT)0;
	
	OUT.Colour = tex2D( g_Texture0, IN.TexCoord0 );
	OUT.Colour *= IN.Colour;
	
	// Do the cutout
	float4 tex1 = tex2D( g_Texture1, IN.TexCoord1 );
	float i2 = ( tex1.r + tex1.g + tex1.b ) / 3;
	
	if ( i2 > g_fCutoutValue )
		OUT.Colour.a = 0.0f;	
	
	return OUT;
}
