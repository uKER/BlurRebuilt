	SPULibrary gravity_shared_spu : $(SPU_SHARED_SRC) ;
	
	SPULibrary gravity_fillcache_spu : $(SPU_FILLCACHE_SRC) ;
	SPULibrary gravity_phantom_mesh_lib : $(SPU_PHANTOM_MESH_SRC) ;

	LinkLibraries	gravity_raytrace
					gravity_transparentraytrace
					gravity_meshcollision
					gravity_phantommeshcollision
					gravity_groundplanecollision
					gravity_solver
					gravity_waterquery
					gravity_continuous_collision
					gravity_fluid_collision
					gravity_ragdoll_controller
					gravity_animated_controller
					gravity_dynamic_phantom_collision
					gravity_fillcache
					gravity_dynamic_collision
					gravity_dynamicoverlay_collision
					gravity_integrate
					gravity_kinematic
					gravity_post_integrate
					: gravity_shared_spu core_spu $(SCE_PS3_ROOT)/target/spu/lib/libm.a ;

	AddSPUModule gravity : gravity_raytrace : $(SPU_RT_SRC) ;
	AddSPUModule gravity : gravity_transparentraytrace : $(SPU_TRT_SRC) ;
	AddSPUModule gravity : gravity_meshcollision : $(SPU_MC_SRC) ;
	AddSPUModule gravity : gravity_phantommeshcollision : $(SPU_PHMC_SRC) ;
	AddSPUModule gravity : gravity_groundplanecollision : $(SPU_GP_SRC) ;
	AddSPUModule gravity : gravity_solver : $(SPU_SLV_SRC) $(SPU_SLV_SAFE_SRC) ;
	AddSPUModule gravity : gravity_dynamic_collision : $(SPU_DC_SRC) ;
	AddSPUModule gravity : gravity_dynamic_phantom_collision : $(SPU_PHDC_SRC) ;
	AddSPUModule gravity : gravity_waterquery : $(SPU_WATERQUERY_SRC) ;
	AddSPUModule gravity : gravity_fluid_collision : $(SPU_FCD_SRC) ;
	AddSPUModule gravity : gravity_continuous_collision : $(SPU_CCD_SRC) ;
	AddSPUModule gravity : gravity_ragdoll_controller : $(SPU_RC_SRC) $(SPU_SLV_SRC) ;
	AddSPUModule gravity : gravity_animated_controller : $(SPU_ANIMATED_SRC) $(SPU_SLV_SRC) ;
	AddSPUModule gravity : gravity_integrate : $(SPU_INT_SRC) ;
	AddSPUModule gravity : gravity_kinematic : $(SPU_KIN_SRC) $(SPU_SLV_SRC) ;
	AddSPUModule gravity : gravity_post_integrate : $(SPU_PIN_SRC) ;
	#AddSPUModule gravity : gravity_fillcache : $(SPU_FC_SRC) ;
	#AddSPUModule gravity : gravity_dynamicoverlay_collision : <__spu__dco>$(SPU_DCO_SRC) ;
}

